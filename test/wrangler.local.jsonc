{
  // The test harness's copy of wrangler.jsonc. Same Worker, same assets, same
  // routing -- a local database instead of a real one.
  //
  // It is a copy rather than an environment of the real config because the
  // real config's database_id is a placeholder until the databases exist, and
  // a suite that cannot run until someone has deployed is a suite nobody runs.
  // tools/verify-worker-config.mjs fails if the two drift apart on anything
  // that changes how a request is answered.
  "name": "chapala-seminary-local",
  "main": "../worker/index.js",
  "compatibility_date": "2026-09-01",
  // Nothing is emailed in tests: /api/email/start returns the code instead.
  // AI grading in the suite: a fake model that answers from hints in the
  // student's text (worker/grading/fake-ai.js), and the live mode the pages are
  // built for. AI_FAKE is for this file alone: tools/verify-worker-config.mjs
  // refuses it in any deployed configuration. The suites for the old rules ask
  // for the old behaviour per request (worker/grading/mode.js).
  "triggers": { "crons": ["0 15 * * *", "*/15 * * * *"] },
  "vars": {
    "AI_FAKE": "1", "GRADING_MODE": "live",
    "GRADER_MODEL": "@cf/test/primary", "GRADER_MODEL_FALLBACK": "@cf/test/fallback", "GRADER_PROMPT_VERSION": "test.1",
    "EMAIL_MODE": "log", "NOTIFY_TO": "info@example.test",
    // The staff pages, checked against the suite's own signing key instead of
    // Cloudflare Access's (test/fixtures/access-test-key.json holds the private
    // half). Never in wrangler.jsonc: tools/verify-worker-config.mjs refuses it.
    "ACCESS_TEAM": "cts-test", "ACCESS_AUD": "cts-test-aud",
    // The coordinators' pages (/coord, worker/coord.js): a second Access application,
    // signed with the same test key, with its own audience tag.
    "COORD_ACCESS_AUD": "cts-coord-test-aud",
    "ACCESS_JWKS": "{\"keys\":[{\"kty\":\"RSA\",\"n\":\"uAFzmd-9jg-cUHuUUsMwCkiJaUjShNmipEeaYXoSgDvVcGjK0AEeJJZYwvTk5EtW2AWCy5_iL-HK6gUDHVEogApIj2F1mMXFZsb76cLMZL1C1pnOBK6Pl5xlrf8Jvuc_dAdskUOFQNO3c3Cdyr6tvCWsrdGyGIsNYpno7qVPs5twkSpfvw_SvzkDD2A9iJcYlqADqkeIXz_fD0yABLXx_tgIZJvRAPl7CV1BNBlqRZDxi_eu2PiA_wDjDwUTYLovQhSwRZERGMyWU0umh0SoYW1UPrLP-EXxfxUi-oxwHSImIbV19hx5OKHnZN925llnl0cATZXe3oM7oE5zBx2sqQ\",\"e\":\"AQAB\",\"kid\":\"cts-test-1\",\"alg\":\"RS256\",\"use\":\"sig\"}]}",
    // notes to students are "sent" -- in log mode, which sends nothing
    "OUTREACH_MODE": "send", "SITE_ORIGIN": "https://chapalaseminary.org",
    // The Master's five-reading test on Pentecostalism, as if activated on 1 Jan
    // 2001, so the suite sees the rule in force (worker/api.js testRequiredFrom;
    // test/required-tests.api.mjs). Never in wrangler.jsonc:
    // tools/verify-worker-config.mjs refuses it.
    // Every test with a date in src/data/required-from.json is held at "not yet
    // required" (2099), so the suite does not change when that date passes; the
    // rule itself is tested on pentecostalreadings above. test/required-tests.test.mjs
    // keeps this list equal to required-from.json.
    "TEST_REQUIRED_FROM": "{\"pentecostalreadings\":\"2001-01-01T00:00:00Z\",\"chreadings\":\"2099-01-01T00:00:00Z\",\"elecbapfive\":\"2099-01-01T00:00:00Z\",\"elecbapfivereadings\":\"2099-01-01T00:00:00Z\",\"elecbapfour\":\"2099-01-01T00:00:00Z\",\"elecbapfourreadings\":\"2099-01-01T00:00:00Z\",\"elecbapone\":\"2099-01-01T00:00:00Z\",\"elecbaponereadings\":\"2099-01-01T00:00:00Z\",\"elecbapthree\":\"2099-01-01T00:00:00Z\",\"elecbapthreereadings\":\"2099-01-01T00:00:00Z\",\"elecbaptwo\":\"2099-01-01T00:00:00Z\",\"elecbaptworeadings\":\"2099-01-01T00:00:00Z\",\"elecpcfive\":\"2099-01-01T00:00:00Z\",\"elecpcfivereadings\":\"2099-01-01T00:00:00Z\",\"elecpcfour\":\"2099-01-01T00:00:00Z\",\"elecpcfourreadings\":\"2099-01-01T00:00:00Z\",\"elecpcone\":\"2099-01-01T00:00:00Z\",\"elecpconereadings\":\"2099-01-01T00:00:00Z\",\"elecpcthree\":\"2099-01-01T00:00:00Z\",\"elecpcthreereadings\":\"2099-01-01T00:00:00Z\",\"elecpctwo\":\"2099-01-01T00:00:00Z\",\"elecpctworeadings\":\"2099-01-01T00:00:00Z\",\"elecreffive\":\"2099-01-01T00:00:00Z\",\"elecreffivereadings\":\"2099-01-01T00:00:00Z\",\"elecreffour\":\"2099-01-01T00:00:00Z\",\"elecreffourreadings\":\"2099-01-01T00:00:00Z\",\"elecrefone\":\"2099-01-01T00:00:00Z\",\"elecrefonereadings\":\"2099-01-01T00:00:00Z\",\"elecrefthree\":\"2099-01-01T00:00:00Z\",\"elecrefthreereadings\":\"2099-01-01T00:00:00Z\",\"elecreftwo\":\"2099-01-01T00:00:00Z\",\"elecreftworeadings\":\"2099-01-01T00:00:00Z\",\"elecwesfive\":\"2099-01-01T00:00:00Z\",\"elecwesfivereadings\":\"2099-01-01T00:00:00Z\",\"elecwesfour\":\"2099-01-01T00:00:00Z\",\"elecwesfourreadings\":\"2099-01-01T00:00:00Z\",\"elecwesone\":\"2099-01-01T00:00:00Z\",\"elecwesonereadings\":\"2099-01-01T00:00:00Z\",\"elecwesthree\":\"2099-01-01T00:00:00Z\",\"elecwesthreereadings\":\"2099-01-01T00:00:00Z\",\"elecwestwo\":\"2099-01-01T00:00:00Z\",\"elecwestworeadings\":\"2099-01-01T00:00:00Z\",\"evangelismreadings\":\"2099-01-01T00:00:00Z\",\"hermeneuticsreadings\":\"2099-01-01T00:00:00Z\",\"ntreadings\":\"2099-01-01T00:00:00Z\",\"otsreadings\":\"2099-01-01T00:00:00Z\",\"pmreadings\":\"2099-01-01T00:00:00Z\",\"streadings\":\"2099-01-01T00:00:00Z\",\"wisespeakreadings\":\"2099-01-01T00:00:00Z\"}"
  },
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "chapala-students", "database_id": "local-dev" }
  ]
}
