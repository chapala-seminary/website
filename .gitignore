# the test harness's config lives in test/.
test/.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
wrangler.toml.local

# ---- Secrets ----
.env
.env.*
!.env.example
*.pem
*.key
# Private answer-bank checkout used by the beta Actions deploy (not committed).
.assessment-keys/

# ---- Migration scratch ----
tools/_work/
tools/_reports/
*.orig
*.rej

# ---- Mutation harness (tools/mutation-suite.mjs) ----
# Backups of files it deliberately breaks, so an interrupted run can be undone.
.mutation-backup/
