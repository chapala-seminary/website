.assessment-keys/

# ---- Migration scratch ----
tools/_work/
tools/_reports/
*.orig
*.rej

# ---- Mutation harness (tools/mutation-suite.mjs) ----
# Backups of files it deliberately breaks, so an interrupted run can be undone.
.mutation-backup/

