---
/* One layout for the textbook pages: the book itself (CTSTextbookX.html) and
 * its test (CTSTextbookXTest.html). The same masthead, language control and
 * footer as a unit page, without the unit navigation, the registration card
 * and the exam engine, none of which apply: a textbook is read, and its test
 * is a page of its own (src/pages/[test].astro), so the browser's Find cannot
 * search the book for an answer -- the reason Dr. Cook asked for separate
 * pages (3 Oct 2026).
 */
import { version } from '../lib/version';
import { live } from '../lib/grading-mode';

interface Bi { en: string; es: string; fr?: string }
interface Book { slug: string; page: string; course: string; title: Bi; subtitle?: Bi; credits?: Bi; edition: string }
interface Card { entry: string; title: Bi }
interface Props {
  kind: 'book' | 'test' | 'reading-test';   // reading-test: a required-reading test (src/pages/[readingtest].astro)
  book: Book;
  course: Card;
  accent: string | null;      // the course's storage slug, for its colour
  scripts?: string[];
  sync?: boolean;             // the test page: a pass goes to the student record
}
const { kind, book, course, accent, scripts = [], sync = false } = Astro.props;
const title = kind === 'book' ? `CTS Textbook: ${book.title.en}`
  : kind === 'reading-test' ? `CTS Required-Reading Test: ${book.title.en}`
  : `CTS Textbook Test: ${book.title.en}`;
const reading = kind === 'reading-test';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href={version('/assets/css/cts.css')} />
  </head>
  <body class="lang-en" data-course={accent ?? undefined} data-textbook={book.slug} data-textbook-page={kind} data-textbook-kind={reading ? 'reading' : 'textbook'}>
    <script is:inline src={version('/cts-lang.js')}></script>
    <a class="btn skip" href="#content" style="position:absolute;left:-9999px" data-cts-chrome>
      <span class="lang-en">Skip to the content</span><span class="lang-es">Saltar al contenido</span><span class="lang-fr">Aller au contenu</span>
    </a>

    <header class="cts-masthead">
      <div class="wrap">
        <div class="eyebrow" data-cts-chrome>
          <span class="lang-en">{kind === 'book' ? "Master's textbook" : reading ? 'Required readings · test' : "Master's textbook · test"}</span>
          <span class="lang-es">{kind === 'book' ? 'Libro de texto de maestría' : reading ? 'Lecturas requeridas · examen' : 'Libro de texto de maestría · examen'}</span>
          <span class="lang-fr">{kind === 'book' ? 'Manuel de master' : reading ? 'Lectures obligatoires · examen' : 'Manuel de master · examen'}</span>
        </div>
        <h1 data-cts-chrome>{reading ? '📖' : '📘'} <span class="lang-en">{book.title.en}</span><span class="lang-es">{book.title.es}</span><span class="lang-fr">{book.title.fr}</span></h1>
        {book.subtitle && (book.subtitle.en || book.subtitle.es) && (
          <h2><span class="lang-en">{book.subtitle.en}</span><span class="lang-es">{book.subtitle.es}</span>{book.subtitle.fr && <span class="lang-fr">{book.subtitle.fr}</span>}</h2>
        )}
        {book.credits && (book.credits.en || book.credits.es) && (
          <p class="credits"><span class="lang-en">{book.credits.en}</span><span class="lang-es">{book.credits.es}</span>{book.credits.fr && <span class="lang-fr">{book.credits.fr}</span>}</p>
        )}
      </div>
    </header>

    <nav class="cts-nav" aria-label="Textbook" data-cts-chrome>
      <div class="wrap">
        <div class="cts-navmain">
          <div class="cts-steps">
            <a class="btn" href={`/${course.entry}`}>← <span class="lang-en">Course: {course.title.en}</span><span class="lang-es">Curso: {course.title.es}</span><span class="lang-fr">Cours : {course.title.fr}</span></a>
            {kind === 'book'
              ? <a class="btn solid" href={`/${book.page}Test.html`}><span class="lang-en">Textbook test</span><span class="lang-es">Examen del libro</span><span class="lang-fr">Examen du manuel</span> →</a>
              : reading
              ? <a class="btn solid" href={`/${book.page}.html`}>← <span class="lang-en">The readings</span><span class="lang-es">Las lecturas</span><span class="lang-fr">Les lectures</span></a>
              : <a class="btn solid" href={`/${book.page}.html`}>← <span class="lang-en">Read the textbook</span><span class="lang-es">Leer el libro</span><span class="lang-fr">Lire le manuel</span></a>}
          </div>
        </div>
        <div class="cts-seg" role="group" aria-label="Language / Idioma">
          <button type="button" data-lang="en">English</button>
          <button type="button" data-lang="es">Español</button>
          <button type="button" data-lang="both"><span class="lang-en">Both</span><span class="lang-es">Ambos</span></button>
        </div>
      </div>
    </nav>

    <main class="wrap" id="content">
      <slot />
    </main>

    <footer class="cts-foot" data-cts-chrome>
      <div class="wrap">
        <span>
          <span class="lang-en">Chapala Theological Seminary · Free theological training in English, Spanish and French.</span>
          <span class="lang-es">Seminario Teológico de Chapala · Formación teológica gratuita en inglés, español y francés.</span>
          <span class="lang-fr">Séminaire théologique de Chapala · Formation théologique gratuite en anglais, en espagnol et en français.</span>
        </span>
        <span>
          <a href="/CTSStudyLibrary.html#textbooks"><span class="lang-en">All textbooks</span><span class="lang-es">Todos los libros de texto</span><span class="lang-fr">Tous les manuels</span></a>
          &nbsp;·&nbsp;
          <a href="/index.html#catalog"><span class="lang-en">All courses</span><span class="lang-es">Todos los cursos</span><span class="lang-fr">Tous les cours</span></a>
          &nbsp;·&nbsp;
          <a href="/CTSPrivacy.html"><span class="lang-en">Your information</span><span class="lang-es">Su información</span><span class="lang-fr">Vos informations</span></a>
        </span>
      </div>
    </footer>

    {live && sync && <script is:inline src={version('/assets/js/cts-grading.js')}></script>}
    {scripts.map((src) => <script is:inline src={version(src)}></script>)}
    <script is:inline src={version('/assets/js/cts-textbook.js')}></script>
    {sync && <script is:inline src={version('/assets/js/cts-sync.js')} defer></script>}
    {!live && sync && <script is:inline src={version('/assets/js/cts-shadow.js')} defer></script>}
  </body>
</html>
