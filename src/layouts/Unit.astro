---
/* One layout for every unit page.
 *
 * Until now this carried the body verbatim, furniture and all, which is why
 * the site had 102 stylesheets and no two courses looked alike. The body is
 * still never edited -- src/lib/shell.ts lifts the title block out and drops
 * the navigation the layout now renders itself, and passes the lesson through
 * untouched. tools/prose-baseline.mjs is what makes that safe to assert.
 */
import { shell } from '../lib/shell';
import { version } from '../lib/version';
import catalog from '../../worker/catalog.json';
import { live, liveUnit, unitScope } from '../lib/grading-mode';

interface Unit {
  course: string;
  unit: number;
  totalUnits: number;
  prevHref: string | null;
  nextHref: string | null;
  filePrefix?: string;
  [k: string]: unknown;
}
interface Props {
  title: string;
  bodyClass: string;
  styles: string[];
  scripts: string[];
  unit: Unit;
  body: string;
  pagePrefix: string;
  unitNumbers: number[];
  /* The course's required tests, when it has any: its Master's textbook
     (src/content/textbooks), its required readings (src/content/readings), or
     both (9 Oct 2026). A box under the greeting on every unit for each, with
     the book or the readings and the test. `requiredFrom` null: a reading
     test not yet in force. */
  tests?: { page: string; title: { en: string; es: string; fr: string }; kind: 'textbook' | 'reading'; requiredFrom?: string | null }[];
}
const { title, bodyClass, styles, scripts, unit, body, pagePrefix, unitNumbers, tests = [] } = Astro.props;

const { masthead, content } = shell(body);

/* 55 of the 451 pages carried no language class on <body>: they hid the other
   language from their own inline script, and their own stylesheet set the
   default. With one stylesheet for the site there is one convention, and a
   page that names no language opens in English like every other. Without this
   those pages show both languages stacked, and a check that only asks whether
   Spanish appeared would call that a pass. */
const cls = bodyClass && /\blang-(en|es|both)\b/.test(bodyClass) ? bodyClass
          : `${bodyClass} lang-en`.trim();

// The unit pills: one per unit the course actually has (Counseling
// Situations runs 0..12). Which are finished is the engine's business at
// runtime, because it is the only thing that knows what this browser has
// completed.
const pills = unitNumbers
  .map((n) => ({ n, href: `${pagePrefix}Unit${n}.html`, here: n === unit.unit }));

// What finishing this course records (public/assets/js/cts-record.js): the
// code the certificate page and the degrees use, the name the degree pages
// count, and every unit it takes. From worker/catalog.json, which is generated
// from the same unit files and certificate pages, so the Worker and the page
// cannot disagree about what a course is.
const cat = (catalog.courses as Record<string, { code: string; units: number[]; tests?: string[] }>)[unit.course];
const done = cat && (catalog.completions as Record<string, { name: string; page: string }>)[cat.code];
if (!cat || !done) throw new Error(`worker/catalog.json has no course "${unit.course}": run node tools/gen-worker-catalog.mjs`);
const tbMap = catalog.textbooks as Record<string, { page: string; kind: string; requiredFrom?: string | null }>;
const required = (cat.tests ?? []).map((slug) => ({ slug, page: tbMap[slug].page, kind: tbMap[slug].kind,
  ...('requiredFrom' in tbMap[slug] ? { requiredFrom: tbMap[slug].requiredFrom } : {}) }));
const first = cat.tests?.[0] ?? null;
/* Live mode (docs/ai-grading.md): the page carries no answers, accept lists,
   model answers, keywords, rubrics or multiple-choice keys, and every
   question has its id. Shadow mode: the unit exactly as it was. */
const unitData = live ? liveUnit(unit, unitScope(pagePrefix, unit.unit)) : unit;
const unitJson = JSON.stringify({ ...unitData,
  completion: { slug: unit.course, code: cat.code, name: done.name, page: done.page, units: cat.units,
                // the course's Master's textbook, which the master's tracks must pass the test of
                textbook: first,
                textbookPage: first ? tbMap[first].page : null,
                // "textbook", or "reading" for a required-reading test (the same rule, other words)
                textbookKind: first ? tbMap[first].kind : null,
                // every test the course requires, textbook first (cts-record.js holds the course for each)
                // (only where it says more than the three fields above: two tests, or an activation date)
                ...(required.length > 1 || required.some((t) => 'requiredFrom' in t) ? { tests: required } : {}) },
}).replace(/</g, '\\u003c');

/* Each script and the stylesheet are addressed with a fingerprint of their
   contents (src/lib/version.ts says why). A hand-kept ?v=... in a unit's
   script list is replaced, because it is only right until someone forgets it. */

// The language classes come from the body class the page already had; a page
// that opened in Spanish still does.
const lang = /lang-es/.test(bodyClass) ? 'es' : 'en';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap"
    />
    <link rel="stylesheet" href={version('/assets/css/cts.css')} />
    {/* The 102 per-page stylesheets are gone; `styles` is kept in the schema
        only so a course with a genuinely special need can opt back in, and
        today none do. Loading them here was what made the unified design
        invisible: they came after cts.css and simply won. */}
  </head>
  <body class={cls} data-course={unit.course}>
    {/* The student's language, restored before anything paints. 414 pages
        listed cts-lang.js themselves and 37 did not -- Bible, Genesis,
        Galatians, Pentecostal -- so those opened in English whatever the
        student had chosen (Dr. Cook's beta pass, 30 Sept). Every unit loads
        it here now, once. */}
    <script is:inline src={version('/cts-lang.js')}></script>
    <a class="btn skip" href="#lesson" style="position:absolute;left:-9999px" data-cts-chrome>
      <span class="lang-en">Skip to the lesson</span><span class="lang-es">Saltar a la lección</span><span class="lang-fr">Aller à la leçon</span>
    </a>

    <header class="cts-masthead">
      <div class="wrap" set:html={masthead || `<h1>${title}</h1>`} />
    </header>
    <nav class="cts-crumbs wrap" aria-label="Breadcrumb" data-cts-chrome>
      <a href="/index.html"><span class="lang-en">Home</span><span class="lang-es">Inicio</span><span class="lang-fr">Accueil</span></a>
      {' · '}
      <a href={`/${pagePrefix}Course.html`}><span class="lang-en">Course</span><span class="lang-es">Curso</span><span class="lang-fr">Cours</span></a>
      {' · '}
      <span class="lang-en">Unit {unit.unit}</span><span class="lang-es">Unidad {unit.unit}</span><span class="lang-fr">Unité {unit.unit}</span>
    </nav>

    <nav class="cts-nav" aria-label="Course units" data-cts-chrome>
      <div class="wrap">
        <div class="cts-navmain">
          <ul class="cts-units" id="cts-units">
            {pills.map((p) => (
              <li>
                <a
                  href={p.href}
                  class={p.here ? 'here' : ''}
                  data-unit={p.n}
                  aria-current={p.here ? 'page' : undefined}
                >{p.n}</a>
              </li>
            ))}
          </ul>
          <div class="cts-steps">
            {unit.prevHref ? (
              <a class="btn" href={unit.prevHref}>← <span class="lang-en">Previous</span><span class="lang-es">Anterior</span><span class="lang-fr">Précédent</span></a>
            ) : (
              <span class="btn" aria-disabled="true" style="opacity:.4">← <span class="lang-en">Previous</span><span class="lang-es">Anterior</span><span class="lang-fr">Précédent</span></span>
            )}
            {unit.nextHref ? (
              <a class="btn solid" id="cts-next" href={unit.nextHref}><span class="lang-en">Next</span><span class="lang-es">Siguiente</span><span class="lang-fr">Suivant</span> →</a>
            ) : (
              <span class="btn solid" aria-disabled="true" style="opacity:.4"><span class="lang-en">Next</span><span class="lang-es">Siguiente</span><span class="lang-fr">Suivant</span> →</span>
            )}
          </div>
        </div>
        <div class="cts-seg" role="group" aria-label="Language / Idioma">
          <button type="button" data-lang="en">English</button>
          <button type="button" data-lang="es">Español</button>
          <button type="button" data-lang="both"><span class="lang-en">Both</span><span class="lang-es">Ambos</span></button>
        </div>
      </div>
    </nav>

    <main class="wrap" id="lesson">
      {/* One registration card for the whole seminary. Every course used to
          carry its own -- forty-four of them, with forty-four wordings and
          forty-four sets of field names -- which is why cts-engine.js still
          reads five spellings of "name". The engine hides this once a student
          is registered; a student registers once, in any course, for all. */}
      <section class="reg-form" id="cts-register" hidden data-cts-chrome>
        <h2>
          <span class="lang-en">Register once, for every course</span>
          <span class="lang-es">Regístrese una vez, para todos los cursos</span>
          <span class="lang-fr">Une seule inscription pour tous les cours</span>
        </h2>
        <p>
          <span class="lang-en">Your progress is saved in this browser as you study, and kept with the seminary under your student code, so you can continue on any device. Keep the code private, like a password. A confirmed email is needed only to receive a certificate. <a href="/CTSPrivacy.html">What we keep</a>.</span>
          <span class="lang-es">Su progreso se guarda en este navegador mientras estudia, y en el seminario bajo su código de estudiante, para que pueda continuar en cualquier dispositivo. Mantenga el código en privado, como una contraseña. Solo se necesita un correo confirmado para recibir un certificado. <a href="/CTSPrivacy.html">Lo que guardamos</a>.</span>
          <span class="lang-fr">Votre progression est enregistrée dans ce navigateur et conservée par le séminaire sous votre code étudiant, pour continuer sur tout appareil. Gardez ce code privé, comme un mot de passe. Une adresse e-mail confirmée est nécessaire uniquement pour recevoir un certificat. <a href="/CTSPrivacy.html">Les informations conservées</a>.</span>
        </p>
        <div class="registration-fields">
          <div class="full">
            <label for="regName">
              <span class="lang-en">Full name — as it should appear on your certificate</span>
              <span class="lang-es">Nombre completo — como debe aparecer en su certificado</span>
              <span class="lang-fr">Nom complet — tel qu’il doit apparaître sur votre certificat</span>
            </label>
            <input id="regName" type="text" autocomplete="name" />
          </div>
          <div class="full">
            <label for="regEmail"><span class="lang-en">Email (required)</span><span class="lang-es">Correo electrónico (obligatorio)</span><span class="lang-fr">Adresse e-mail (obligatoire)</span></label>
            <input id="regEmail" type="email" autocomplete="email" required />
          </div>
          <div>
            <label for="regCountry"><span class="lang-en">Country</span><span class="lang-es">País</span><span class="lang-fr">Pays</span></label>
            <input id="regCountry" type="text" autocomplete="country-name" />
          </div>
          <div>
            <label for="regTrack"><span class="lang-en">Study track</span><span class="lang-es">Trayecto de estudio</span><span class="lang-fr">Parcours d’études</span></label>
            <select id="regTrack">
              <option value="cert" data-es="Certificado de Ministerio" data-fr="Certificat de ministère">Certificate of Ministry</option>
              <option value="ad" data-es="Asociado en Divinidad" data-fr="Diplôme associé en théologie">Associate of Divinity</option>
              <option value="mdiv" data-es="Maestría en Divinidad (M.Div.)" data-fr="Master en théologie pastorale (M.Div.)">Master of Divinity</option>
              <option value="thm" data-es="Maestría en Teología (Th.M.)" data-fr="Master en théologie (Th.M.)">Master of Theology (Th.M.)</option>
            </select>
          </div>
          <div class="full">
            <button class="btn solid" type="button" id="regSave">
              <span class="lang-en">Save registration</span><span class="lang-es">Guardar registro</span><span class="lang-fr">Enregistrer l’inscription</span>
            </button>
          </div>
        </div>
        <p id="regError" role="alert" hidden></p>
        <p class="small" style="margin-bottom:0">
          <span class="lang-en">The Certificate track answers the multiple choice. The Associate adds the fill-in-the-blank questions; M.Div. and Th.M. add those and the short-answer questions. 90% of each part is required to pass.</span>
          <span class="lang-es">El trayecto de Certificado responde la opción múltiple. El Asociado añade las preguntas de completar el espacio en blanco; M.Div. y Th.M. añaden esas y las preguntas de desarrollo. Se requiere 90% en cada parte para aprobar.</span>
          <span class="lang-fr">Le parcours Certificat comprend les questions à choix multiple. Le diplôme associé ajoute les questions à compléter ; les parcours M.Div. et Th.M. ajoutent aussi les questions à réponse courte. Il faut 90 % dans chaque partie pour réussir.</span>
        </p>
      </section>
      <p id="greeting" class="muted" style="margin-top:0"></p>
      {tests.map((t, i) => t.kind === 'reading' ? (
        <aside class="cts-textbook" id={i === 0 ? 'cts-textbook' : 'cts-required-readings'} data-kind="reading" data-cts-chrome>
          <span class="cts-textbook-mark" aria-hidden="true">📖</span>
          <span>
            <strong><span class="lang-en">Required readings for this course</span><span class="lang-es">Lecturas requeridas de este curso</span><span class="lang-fr">Lectures obligatoires pour ce cours</span></strong>
            {t.requiredFrom === null
              ? <Fragment><span class="lang-en"> — a separate test on all five readings for M.Div. and Th.M. after activation; see the test page; open to every student: </span><span class="lang-es"> — un examen separado sobre las cinco lecturas para M.Div. y Th.M. después de su activación; consulte la página del examen; abierto a todos los estudiantes: </span><span class="lang-fr"> — un examen distinct sur les cinq lectures, pour les parcours M.Div. et Th.M., après son activation ; voir la page de l’examen ; ouvert à tous les étudiants : </span></Fragment>
              : <Fragment><span class="lang-en"> — required on the M.Div. and Th.M. tracks, open to every student: </span><span class="lang-es"> — obligatorias en los trayectos M.Div. y Th.M., abiertas a todos los estudiantes: </span><span class="lang-fr"> — obligatoires pour les parcours M.Div. et Th.M., ouvertes à tous les étudiants : </span></Fragment>}
            <a href={`/${t.page}.html`}><span class="lang-en">{t.title.en}</span><span class="lang-es">{t.title.es}</span><span class="lang-fr">{t.title.fr}</span></a>
            &nbsp;·&nbsp;
            <a href={`/${t.page}Test.html`}><span class="lang-en">Required-reading test</span><span class="lang-es">Examen de lecturas requeridas</span><span class="lang-fr">Examen des lectures obligatoires</span></a>
          </span>
        </aside>
      ) : (
        <aside class="cts-textbook" id={i === 0 ? 'cts-textbook' : 'cts-textbook-2'} data-cts-chrome>
          <span class="cts-textbook-mark" aria-hidden="true">📘</span>
          <span>
            <strong><span class="lang-en">Textbook for this course</span><span class="lang-es">Libro de texto de este curso</span><span class="lang-fr">Manuel pour ce cours</span></strong>
            {t.requiredFrom === null ? (
              <><span class="lang-en"> — Master’s test after activation; see the test page: </span><span class="lang-es"> — examen de maestría después de su activación; consulte la página del examen: </span><span class="lang-fr"> — examen de master après son activation ; voir la page de l’examen : </span></>
            ) : (
              <><span class="lang-en"> — required reading on the M.Div. and Th.M. tracks: </span><span class="lang-es"> — lectura obligatoria en los trayectos M.Div. y Th.M.: </span><span class="lang-fr"> — lecture obligatoire pour les parcours M.Div. et Th.M. : </span></>
            )}
            <a href={`/${t.page}.html`}><span class="lang-en">{t.title.en}</span><span class="lang-es">{t.title.es}</span><span class="lang-fr">{t.title.fr}</span></a>
            &nbsp;·&nbsp;
            <a href={`/${t.page}Test.html`}><span class="lang-en">Textbook test</span><span class="lang-es">Examen del libro</span><span class="lang-fr">Examen du manuel</span></a>
          </span>
        </aside>
      ))}

      <Fragment set:html={content} />
    </main>

    <footer class="cts-foot" data-cts-chrome>
      <div class="wrap">
        <span>
          <span class="lang-en">Chapala Theological Seminary · Free theological training in English, Spanish and French.</span>
          <span class="lang-es">Seminario Teológico de Chapala · Formación teológica gratuita en inglés, español y francés.</span>
          <span class="lang-fr">Séminaire théologique de Chapala · Formation théologique gratuite en anglais, en espagnol et en français.</span>
        </span>
        <span>
          <a href={`/${pagePrefix}Course.html`}><span class="lang-en">Course overview</span><span class="lang-es">Resumen del curso</span><span class="lang-fr">Présentation du cours</span></a>
          &nbsp;·&nbsp;
          <a href="/index.html#catalog"><span class="lang-en">All courses</span><span class="lang-es">Todos los cursos</span><span class="lang-fr">Tous les cours</span></a>
          &nbsp;·&nbsp;
          <a href="/cts-backup.html"><span class="lang-en">Save my progress</span><span class="lang-es">Guardar mi progreso</span><span class="lang-fr">Enregistrer ma progression</span></a>
          &nbsp;&middot;&nbsp;
          <a href="/CTSPrivacy.html"><span class="lang-en">Your information</span><span class="lang-es">Su información</span><span class="lang-fr">Vos informations</span></a>
        </span>
      </div>
    </footer>

    <script is:inline set:html={`window.CTS_UNIT = ${unitJson};`} />
    <script is:inline src={version('/assets/js/cts-record.js')}></script>
    {live && <script is:inline src={version('/assets/js/cts-grading.js')}></script>}
    <script is:inline src={version('/assets/js/cts-engine.js')}></script>
    {scripts.filter((src) => !/(^|\/)cts-lang\.js$/.test(src)).map((src) => <script is:inline src={version(src)}></script>)}
    {/* The lesson and the exam are never shown together, so the browser's
        Find cannot search the lesson for an answer (Dr. Cook's review, 29 Sept). */}
    <script is:inline src={version('/assets/js/cts-exam-view.js')}></script>
    <script is:inline src={version('/assets/js/cts-fields-lang.js')}></script>
    {/* Mirrors this browser's progress to the seminary's database so a cleared
        browser or a new phone is no longer the end of someone's degree. It is
        dormant until the API exists: one probe per tab, then silence. See
        docs/student-records.md. */}
    <script is:inline src={version('/assets/js/cts-sync.js')} defer></script>
    {/* Shadow mode only: posts each submitted unit to /api/shadow, so the AI
        can grade real answers before the switch. Students see nothing. */}
    {!live && <script is:inline src={version('/assets/js/cts-shadow.js')} defer></script>}
  </body>
</html>
