---
/* One layout for the reading rooms (CTS<Course>Readings.html), the World
 * Religions required readings beside its room, and the honors page
 * (cts-honors.html). The furniture of a unit page -- masthead in the course's
 * colour, the sticky bar with the English / Español / Both switch, the footer
 * -- around the room's own content (src/body/rooms), so a student moving from
 * a unit to its readings stays on the same site (Robert, 5 Oct 2026). Until
 * then the 45 rooms were standalone pages with a dozen looks, and 25 of them
 * showed English and Spanish at once with no way to choose.
 */
import { version } from '../lib/version';
import EditorialNotice from '../components/EditorialNotice.astro';

interface Bi { en: string; es: string; fr?: string }
interface Props {
  page: string;                     // the page name, CTSBibleReadings
  kind: 'room' | 'required' | 'honors';
  title: string;                    // <title>, as the page always had it
  heading: Bi;
  tagline?: Bi | null;
  course?: { entry: string; title: Bi } | null;
  accent?: string | null;           // the course's storage slug, for its colour
  body: string;
}
const { page, kind, title, heading, tagline = null, course = null, accent = null, body } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap"
    />
    <link rel="stylesheet" href={version('/assets/css/cts.css')} />
    <link rel="stylesheet" href={version('/assets/css/cts-rooms.css')} />
  </head>
  <body class="lang-en cts-room" data-course={accent ?? undefined} data-room={page} data-room-kind={kind}>
    <script is:inline src={version('/cts-lang.js')}></script>
    <a class="btn skip" href="#content" style="position:absolute;left:-9999px" data-cts-chrome>
      <span class="lang-en">Skip to the content</span><span class="lang-es">Saltar al contenido</span><span class="lang-fr">Aller au contenu</span>
    </a>

    <header class="cts-masthead">
      <div class="wrap">
        <div class="eyebrow" data-cts-chrome>
          {course
            ? <><span class="lang-en">{course.title.en}</span><span class="lang-es">{course.title.es}</span><span class="lang-fr">{course.title.fr}</span></>
            : <><span class="lang-en">Chapala Theological Seminary</span><span class="lang-es">Seminario Teológico de Chapala</span><span class="lang-fr">Séminaire théologique de Chapala</span></>}
        </div>
        <h1 data-cts-chrome><span class="lang-en" set:html={heading.en} /><span class="lang-es" set:html={heading.es} />{heading.fr && <span class="lang-fr" set:html={heading.fr} />}</h1>
        {tagline && <p data-cts-chrome><span class="lang-en" set:html={tagline.en} /><span class="lang-es" set:html={tagline.es} />{tagline.fr && <span class="lang-fr" set:html={tagline.fr} />}</p>}
      </div>
    </header>

    <nav class="cts-nav" aria-label={kind === 'honors' ? 'Reading With Honors' : 'Reading room'} data-cts-chrome>
      <div class="wrap">
        <div class="cts-navmain">
          <div class="cts-steps">
            {course && (
              <a class="btn" href={`/${course.entry}`}>← <span class="lang-en">Back to the course</span><span class="lang-es">Volver al curso</span><span class="lang-fr">Retour au cours</span></a>
            )}
            {kind === 'room' && (
              <a class="btn" href="/cts-honors.html"><span class="lang-en">Reading With Honors</span><span class="lang-es">Lectura con Honores</span><span class="lang-fr">Lecture avec mention</span></a>
            )}
            {kind === 'required' && (
              <a class="btn solid" href={`/${page}Test.html`}><span class="lang-en">Required-reading test</span><span class="lang-es">Examen de lecturas requeridas</span><span class="lang-fr">Examen des lectures obligatoires</span> →</a>
            )}
            {kind === 'honors' && (
              <a class="btn" href="/index.html#catalog">← <span class="lang-en">All courses</span><span class="lang-es">Todos los cursos</span><span class="lang-fr">Tous les cours</span></a>
            )}
          </div>
        </div>
        <div class="cts-seg" role="group" aria-label="Language / Idioma">
          <button type="button" data-lang="en">English</button>
          <button type="button" data-lang="es">Español</button>
          <button type="button" data-lang="both"><span class="lang-en">Both</span><span class="lang-es">Ambos</span></button>
        </div>
      </div>
    </nav>

    <main class="wrap" id="content">
      {kind !== 'honors' && <EditorialNotice kind="perspectives" />}
      {page === 'CTSJoshReadings' && <EditorialNotice kind="blaikie" />}
      {kind !== 'honors' && <section class="card" data-cts-chrome>
        <h2><span class="lang-en">Master’s Assigned Readings (all five)</span><span class="lang-es">Lecturas asignadas de maestría (las cinco)</span><span class="lang-fr">Lectures assignées du master (les cinq)</span></h2>
        <p><span class="lang-en">M.Div. and Th.M. students read all five assigned selections and take their separate exam after activation. The test page states the current rule; valid earlier completions remain valid.</span><span class="lang-es">Los estudiantes M.Div. y Th.M. leen las cinco selecciones asignadas y presentan su examen separado después de su activación. La página del examen indica la regla vigente; las finalizaciones válidas anteriores siguen siendo válidas.</span><span class="lang-fr">Les étudiants M.Div. et Th.M. lisent les cinq textes assignés et passent leur examen distinct après son activation. La page de l’examen indique la règle en vigueur ; les validations antérieures restent acquises.</span></p>
        {page === 'CTSWRReadings' && <p><a href="/CTSWRRequired.html"><span class="lang-en">World Religions: open the separate assigned readings</span><span class="lang-es">Religiones del Mundo: abrir las lecturas asignadas separadas</span><span class="lang-fr">Religions du monde : ouvrir les lectures assignées distinctes</span></a></p>}
        <h3><span class="lang-en">Optional Honors (choose three)</span><span class="lang-es">Honores opcionales (elija tres)</span><span class="lang-fr">Mention facultative (choisissez trois textes)</span></h3>
        <p><span class="lang-en">Honors is optional on every track. Certificate and Associate students may read three honors selections without a required-reading exam. Honors does not replace either master’s exam.</span><span class="lang-es">Los honores son opcionales en todos los trayectos. Los estudiantes de Certificado y Asociado pueden leer tres selecciones para honores sin un examen de lecturas obligatorias. Los honores no sustituyen ninguno de los exámenes de maestría.</span><span class="lang-fr">La mention est facultative pour tous les parcours. Les étudiants du Certificat et du diplôme associé peuvent lire trois textes pour la mention sans examen des lectures obligatoires. La mention ne remplace aucun des examens du master.</span></p>
      </section>}
      <Fragment set:html={body} />
    </main>

    <footer class="cts-foot" data-cts-chrome>
      <div class="wrap">
        <span>
          <span class="lang-en">Chapala Theological Seminary · Free theological training in English, Spanish and French.</span>
          <span class="lang-es">Seminario Teológico de Chapala · Formación teológica gratuita en inglés, español y francés.</span>
          <span class="lang-fr">Séminaire théologique de Chapala · Formation théologique gratuite en anglais, en espagnol et en français.</span>
        </span>
        <span>
          <a href="/index.html#catalog"><span class="lang-en">All courses</span><span class="lang-es">Todos los cursos</span><span class="lang-fr">Tous les cours</span></a>
          {kind !== 'honors' && <>&nbsp;·&nbsp;<a href="/cts-honors.html"><span class="lang-en">Reading With Honors</span><span class="lang-es">Lectura con Honores</span><span class="lang-fr">Lecture avec mention</span></a></>}
          &nbsp;·&nbsp;
          <a href="/CTSPrivacy.html"><span class="lang-en">Your information</span><span class="lang-es">Su información</span><span class="lang-fr">Vos informations</span></a>
        </span>
      </div>
    </footer>

    <script is:inline src={version('/assets/js/cts-room.js')}></script>
  </body>
</html>
