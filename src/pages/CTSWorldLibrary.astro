(function(){const q=document.getElementById('q'),sub=document.getElementById('subject'),lang=document.getElementById('lang'),lev=document.getElementById('level'),cards=[...document.querySelectorAll('.book-card')],counter=document.getElementById('count'),empty=document.getElementById('noresults');function apply(){let shown=0;const t=q.value.trim().toLowerCase();for(const c of cards){const ok=(!t||c.dataset.search.includes(t))&&(!sub.value||c.dataset.subject===sub.value)&&(!lang.value||c.dataset.language.includes(lang.value))&&(!lev.value||c.dataset.level===lev.value);c.classList.toggle('hidden',!ok);if(ok)shown++;}counter.textContent='Showing '+shown+' of '+cards.length+' books';empty.classList.toggle('hidden',shown!==0);}for(const el of [q,sub,lang,lev])el.addEventListener('input',apply);})();
