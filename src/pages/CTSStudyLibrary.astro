---
/* The Study Library (issue #186, Oct 2026): the textbook and required-reading
 * directories that used to make up most of the front page's length, moved
 * here verbatim with the Reading With Honors note and the Study Resources
 * link. The front page links here from its top bar, its Study Library section
 * and its footer; index.html#textbooks (and the lists inside it) redirects
 * here, so old links keep working. Every book and test keeps its own URL.
 */
import { getCollection } from 'astro:content';

const courses = (await getCollection('courses')).map((e) => e.data);
const cardOf = new Map(courses.map((c) => [c.code, c]));

// The Master's textbooks (src/content/textbooks). Each must belong to a course
// in the catalog, or its card has nowhere to point.
// Resource availability is independent of activation; test pages explain the current rule.
const textbooks = (await getCollection('textbooks')).map((e) => e.data)
  .sort((a, b) => a.number - b.number);
for (const t of textbooks)
  if (!cardOf.has(t.course))
    throw new Error(`textbook ${t.slug} belongs to course "${t.course}", which has no catalog card`);
// The required readings (src/content/readings), listed with the textbooks:
// the same rule on the master's tracks, open to every student.
// Include staged tests too: students need the assigned readings before activation.
const readings = (await getCollection('readings')).map((e) => e.data)
  .sort((a, b) => a.title.en.localeCompare(b.title.en));
for (const r of readings)
  if (!cardOf.has(r.course))
    throw new Error(`required readings ${r.slug} belong to course "${r.course}", which has no catalog card`);
// The 45 core courses' readings, and the denominational electives' (slug
// "elec…", tools/build-elective-readings.mjs) in a list of their own.
const coreReadings = readings.filter((r) => !r.slug.startsWith('elec'));
const coreTextbooks = textbooks.filter((t) => !t.slug.startsWith('elec'));
const electiveTextbooks = textbooks.filter((t) => t.slug.startsWith('elec'));
const electiveReadings = readings.filter((r) => r.slug.startsWith('elec'));
