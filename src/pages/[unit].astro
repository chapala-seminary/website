---
import { getCollection } from 'astro:content';
import Unit from '../layouts/Unit.astro';
import { renderLesson, type Lesson } from '../lib/lesson.ts';

// raw bodies, imported at build time so nothing is fetched at runtime
const bodies = import.meta.glob('../body/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

export async function getStaticPaths() {
  const units = await getCollection('units');
  const lessons = await getCollection('lessons');
  // the course's textbook, if it has one (src/content/textbooks), for the box on every unit
  type Test = { page: string; title: { en: string; es: string }; kind: 'textbook' | 'reading'; requiredFrom?: string | null };
  const testsOf = new Map<string, Test[]>();
  const add = (course: string, t: Test) => (testsOf.get(course) ?? testsOf.set(course, []).get(course)!).push(t);
  for (const t of await getCollection('textbooks')) add(t.data.course, { page: t.data.page, title: t.data.title, kind: 'textbook',
    ...('requiredFrom' in t.data ? { requiredFrom: t.data.requiredFrom ?? null } : {}) });
  // and its required readings (src/content/readings): a box of their own, after the textbook's --
  // a course may have both (9 Oct 2026); worker/catalog.json allows one required-reading test a course
  for (const r of await getCollection('readings'))
    add(r.data.course, { page: r.data.page, title: r.data.title, kind: 'reading', ...('requiredFrom' in r.data ? { requiredFrom: r.data.requiredFrom ?? null } : {}) });
  // a course is converted when its lessons are in the collection
  const byUnit = new Map(lessons.map((l) => [`${l.data.course}/${l.data.unit}`, l.data as Lesson]));
  // The units a course actually has, for the pills. Counting 1..totalUnits
  // gave Counseling Situations, whose units run 0..12, a pill 13 that led to
  // a page that does not exist and no pill for its Unit 0.
  const numbers = new Map<string, number[]>();
  for (const e of units) (numbers.get(e.data.pagePrefix) ?? numbers.set(e.data.pagePrefix, []).get(e.data.pagePrefix)!).push(e.data.unit);
  for (const list of numbers.values()) list.sort((a, b) => a - b);
  return units.map((entry) => ({
    // the page name is the URL the site already uses, e.g. CTS1PeterUnit1
    params: { unit: `${entry.data.pagePrefix}Unit${entry.data.unit}` },
    props: { data: entry.data, lesson: byUnit.get(`${entry.data.pagePrefix}/${entry.data.unit}`) ?? null,
             unitNumbers: numbers.get(entry.data.pagePrefix)!,
             tests: testsOf.get(entry.data.pagePrefix) ?? [] },
  }));
}

const { data, lesson, unitNumbers, tests } = Astro.props;

/* Two sources, one page. A course that has been converted renders from its
   lesson data; the rest still render from the HTML file they were written as,
   and will until they are converted too. Both go through the same layout and
   the same transform, so a converted course is not a second kind of page. */
let body: string;
if (lesson) {
  body = renderLesson(lesson);
} else {
  const key = `../body/${data.pagePrefix}Unit${data.unit}.html`;
  body = bodies[key];
  if (body === undefined) throw new Error(`no body file for ${key}`);
}

// pagePrefix is build-time routing, not something the engine reads
const { title, bodyClass, styles, scripts, pagePrefix, ...unit } = data;
---
<Unit title={title} bodyClass={bodyClass} styles={styles} scripts={scripts} unit={unit} body={body} pagePrefix={pagePrefix} unitNumbers={unitNumbers} tests={tests} />
