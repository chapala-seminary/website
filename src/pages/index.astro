---
/* The front page, with its course catalog generated from the collection.
 *
 * Everything outside <section id="catalog"> is the original page, carried
 * verbatim in two halves (src/body/index/head.html and tail.html). That page
 * is half a megabyte of hand-written markup, inline styles and base64 images;
 * rewriting it was not the job. Replacing the 44 hand-maintained course cards
 * with generated ones was.
 */
import { getCollection } from 'astro:content';
import groups from '../data/catalog-groups.json';
import intro from '../data/catalog-intro.json';
import catalog from '../../worker/catalog.json';
import { requiredTests } from '../lib/required-tests.ts';

const head = (await import('../body/index/head.html?raw')).default;
const tail = (await import('../body/index/tail.html?raw')).default;

const courses = (await getCollection('courses'))
  .map((e) => e.data)
  .sort((a, b) => a.order - b.order);

// The Master's textbooks (src/content/textbooks), listed after the courses.
// Each must belong to a course on this page, or its card has nowhere to point.
// Resource availability is independent of activation; test pages explain the current rule.
const textbooks = (await getCollection('textbooks')).map((e) => e.data)
  .sort((a, b) => a.number - b.number);
const cardOf = new Map(courses.map((c) => [c.code, c]));
for (const t of textbooks)
  if (!cardOf.has(t.course))
    throw new Error(`textbook ${t.slug} belongs to course "${t.course}", which has no catalog card`);
// The required readings (src/content/readings), listed with the textbooks:
// the same rule on the master's tracks, open to every student.
// Include staged tests too: students need the assigned readings before activation.
const readings = (await getCollection('readings')).map((e) => e.data)
  .sort((a, b) => a.title.en.localeCompare(b.title.en));
for (const r of readings)
  if (!cardOf.has(r.course))
    throw new Error(`required readings ${r.slug} belong to course "${r.course}", which has no catalog card`);

// The count in words, as the lead above it spells its counts.
const WORDS_EN = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const WORDS_ES = ['Ningún', 'Un', 'Dos', 'Tres', 'Cuatro', 'Cinco', 'Seis', 'Siete', 'Ocho', 'Nueve', 'Diez'];
const readingCount = { en: WORDS_EN[readings.length] ?? String(readings.length), es: WORDS_ES[readings.length] ?? String(readings.length) };

// Invariants the hand-written catalog had no way to enforce.
if (courses.length !== intro.statedCount)
  throw new Error(
    `the catalog lead says ${intro.statedCount} courses but the collection has ` +
    `${courses.length}. Update src/data/catalog-intro.json -- the count is spelled ` +
    `out in words in both languages, so it cannot be derived.`);

const known = new Set(groups.map((g) => g.id));
for (const c of courses)
  if (!known.has(c.group))
    throw new Error(`${c.code} is in group "${c.group}", which has no heading in catalog-groups.json`);

const byGroup = groups.map((g) => ({ ...g, courses: courses.filter((c) => c.group === g.id) }));
const empty = byGroup.filter((g) => !g.courses.length);
if (empty.length)
  throw new Error(`group(s) with a heading but no courses: ${empty.map((g) => g.id).join(', ')}`);
// Every unit course, for cts-record.js's catch-up below: a student who
// finished a course before completion moved off the certificate page, and
// never opens one of its units again, is recorded when they visit the front
// page. Single-page courses record themselves (CTSCurriculum.markComplete).
const recordable = Object.entries(catalog.courses as Record<string, { code: string; units: number[]; tests?: string[] }>)
  .map(([slug, c]) => ({ slug, code: c.code, units: c.units, textbook: c.tests?.[0] ?? null,
    // every test, where there is more to say than the first (two tests, or an activation date: 9 Oct 2026)
    ...((t) => t.length > 1 || t.some((x) => 'requiredFrom' in x) ? { tests: t } : {})(requiredTests(c.tests)),
    name: (catalog.completions as Record<string, { name: string; page: string }>)[c.code].name,
    page: (catalog.completions as Record<string, { name: string; page: string }>)[c.code].page }));
const recordJson = JSON.stringify(recordable).replace(/</g, '\\u003c');
---
<Fragment set:html={head} />
<section id="catalog">
    <div class="kicker"><span class="en">{intro.kicker.en}</span><span class="es">{intro.kicker.es}</span></div>
    <h2 class="section"><span class="en">{intro.heading.en}</span><span class="es">{intro.heading.es}</span></h2>
    <p><span class="en">{intro.lead.en}</span>
    <span class="es">{intro.lead.es}</span></p>
{byGroup.map((g) => (
    <div class="catgroup">
      <h3><span class="en">{g.title.en}</span><span class="es">{g.title.es}</span></h3>
      <div class="grid">
        {g.courses.map((c) => (
        <a class="course" href={c.entry}><div class="c-title"><span class="en">{c.title.en}</span><span class="es">{c.title.es}</span></div><div class="c-desc"><span class="en">{c.description.en}</span><span class="es">{c.description.es}</span></div><span class="c-go"><span class="en">Begin →</span><span class="es">Comenzar →</span></span></a>
        ))}
      </div>
    </div>
))}
  </section>
<section id="textbooks">
    <style is:inline>
      #textbooks .tb-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(258px,1fr));gap:14px;margin-top:14px}
      #textbooks a.textbook{display:block;min-width:0;background:#fffdf9;border:1px solid var(--line,#e2d6c9);border-radius:12px;padding:16px 18px;text-decoration:none;color:inherit}
      #textbooks a.textbook:hover{border-color:var(--gold,#b08324)}
      #textbooks .tb-title{font-family:"Cormorant Garamond",serif;font-size:1.3rem;color:var(--oxblood,#6d2233);line-height:1.12}
      #textbooks .tb-for{font-size:.88rem;color:var(--muted,#6b5b4d);margin-top:5px;line-height:1.45}
      #textbooks .tb-resource{display:flex;flex-direction:column}
      #textbooks .tb-resource>a.textbook{flex:1}
      #textbooks .tb-test-link{padding:10px 16px;color:var(--oxblood,#5a1f1f);font-weight:bold}
      #textbooks .tb-go{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted,#6b5b4d);margin-top:11px;display:inline-block}
    </style>
    <div class="kicker"><span class="en">Required Reading</span><span class="es">Lecturas Obligatorias</span></div>
    <h2 class="section"><span class="en">Master's Textbooks</span><span class="es">Libros de Texto de Maestría</span></h2>
    <p><span class="en">Each of our 45 core courses has a textbook and a separate required-reading test. Both tests are required for new M.Div. and Th.M. course completions after activation; valid earlier master’s completions remain valid. The books and tests are open to every student and optional for Certificate and Associate students.</span>
    <span class="es">Cada uno de nuestros 45 cursos básicos tiene un libro de texto y un examen separado de lecturas requeridas. Ambos exámenes son obligatorios para nuevas finalizaciones M.Div. y Th.M. después de su activación; las finalizaciones de maestría válidas anteriores siguen siendo válidas. Los libros y exámenes están abiertos a todos y son opcionales para estudiantes de Certificado y Asociado.</span></p>
    <div class="tb-grid">
      {textbooks.map((t) => (
        <div class="tb-resource"><a class="textbook" href={`${t.page}.html`}><div class="tb-title"><span class="en">{t.title.en}</span><span class="es">{t.title.es}</span></div><div class="tb-for"><span class="en">For {cardOf.get(t.course)!.title.en}</span><span class="es">Para {cardOf.get(t.course)!.title.es}</span></div><span class="tb-go"><span class="en">Read →</span><span class="es">Leer →</span></span></a><a class="tb-test-link" href={`${t.page}Test.html`}><span class="lang-en">Textbook test →</span><span class="lang-es">Examen del libro →</span><span class="lang-fr">Examen du manuel →</span></a></div>
      ))}
    </div>
    <h3 style="margin-top:26px"><span class="en">Required Readings</span><span class="es">Lecturas Requeridas</span></h3>
    <p><span class="en">All 45 core courses have assigned readings with their own test, separate from the textbook test. Pass each test separately. The optional honors reading attestation is a different activity. Textbooks and assigned readings for the 20 denominational electives are being prepared.</span><span class="es">Los 45 cursos básicos tienen lecturas asignadas con su propio examen, separado del examen del libro. Apruebe cada examen por separado. La constancia opcional de lectura para honores es una actividad distinta. Se están preparando libros de texto y lecturas asignadas para las 20 electivas denominacionales.</span></p>
    <div class="tb-grid" id="required-readings">
      {readings.map((r) => (
        <div class="tb-resource"><a class="textbook reading" href={`${r.page}.html`}><div class="tb-title"><span class="en">{r.title.en}</span><span class="es">{r.title.es}</span></div><div class="tb-for"><span class="en">For {cardOf.get(r.course)!.title.en}</span><span class="es">Para {cardOf.get(r.course)!.title.es}</span></div><span class="tb-go"><span class="en">Read →</span><span class="es">Leer →</span></span></a><a class="tb-test-link" href={`${r.page}Test.html`}><span class="lang-en">Required-reading test →</span><span class="lang-es">Examen de lecturas obligatorias →</span><span class="lang-fr">Examen des lectures obligatoires →</span></a></div>
      ))}
    </div>
  </section>
<script is:inline src="/assets/js/cts-record.js"></script>
<script is:inline set:html={`window.CTSRecord && window.CTSRecord.backfill(${recordJson});`} />
<Fragment set:html={tail} />
