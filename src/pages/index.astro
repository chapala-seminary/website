---
/* The front page, with its course catalog generated from the collection.
 *
 * Everything outside <section id="catalog"> is the original page, carried
 * verbatim in two halves (src/body/index/head.html and tail.html). That page
 * is half a megabyte of hand-written markup, inline styles and base64 images;
 * rewriting it was not the job. Replacing the 44 hand-maintained course cards
 * with generated ones was.
 *
 * Issue #186 (Oct 2026) made the page shorter and mobile-first: the Register
 * button on the first screen, programs as short cards with the requirements
 * verbatim in a fold, the seven foundation courses first and the subject
 * groups folded (<details>, so the cards stay in the page for search engines,
 * screen readers and the gating script), and the textbook and reading
 * directories moved to CTSStudyLibrary.html.
 */
import { getCollection } from 'astro:content';
import groups from '../data/catalog-groups.json';
import intro from '../data/catalog-intro.json';
import catalog from '../../worker/catalog.json';
import { requiredTests } from '../lib/required-tests.ts';
import { FOUNDATION, completionCode } from '../lib/seo';

const head = (await import('../body/index/head.html?raw')).default;
const tail = (await import('../body/index/tail.html?raw')).default;

const courses = (await getCollection('courses'))
  .map((e) => e.data)
  .sort((a, b) => a.order - b.order);

// The textbook and reading directories are on the Study Library page
// (src/pages/CTSStudyLibrary.astro; issue #186), which checks that each
// belongs to a course on this page.

// Invariants the hand-written catalog had no way to enforce.
if (courses.length !== intro.statedCount)
  throw new Error(
    `the catalog lead says ${intro.statedCount} courses but the collection has ` +
    `${courses.length}. Update src/data/catalog-intro.json -- the count is spelled ` +
    `out in words in both languages, so it cannot be derived.`);

const known = new Set(groups.map((g) => g.id));
for (const c of courses)
  if (!known.has(c.group))
    throw new Error(`${c.code} is in group "${c.group}", which has no heading in catalog-groups.json`);

// The seven foundation courses, shown first in the order the welcome names
// them (issue #186). Their cards stay in their subject groups too; these are
// a.fcard, not a.course, so the gating script and its checks count each
// course once.
const foundation = FOUNDATION.map((code) => courses.find((c) => completionCode(c) === code));
if (foundation.some((c) => !c))
  throw new Error(`a foundation course has no catalog card: ${FOUNDATION.filter((_, i) => !foundation[i]).join(', ')}`);
const byGroup = groups.map((g) => ({ ...g, courses: courses.filter((c) => c.group === g.id) }));
const firstElective = groups.find((g) => g.id.endsWith('-electives'))?.id;
const empty = byGroup.filter((g) => !g.courses.length);
if (empty.length)
  throw new Error(`group(s) with a heading but no courses: ${empty.map((g) => g.id).join(', ')}`);
// Every unit course, for cts-record.js's catch-up below: a student who
// finished a course before completion moved off the certificate page, and
// never opens one of its units again, is recorded when they visit the front
// page. Single-page courses record themselves (CTSCurriculum.markComplete).
const recordable = Object.entries(catalog.courses as Record<string, { code: string; units: number[]; tests?: string[] }>)
  .map(([slug, c]) => ({ slug, code: c.code, units: c.units, textbook: c.tests?.[0] ?? null,
    // every test, where there is more to say than the first (two tests, or an activation date: 9 Oct 2026)
    ...((t) => t.length > 1 || t.some((x) => 'requiredFrom' in x) ? { tests: t } : {})(requiredTests(c.tests)),
    name: (catalog.completions as Record<string, { name: string; page: string }>)[c.code].name,
    page: (catalog.completions as Record<string, { name: string; page: string }>)[c.code].page }));
const recordJson = JSON.stringify(recordable).replace(/</g, '\\u003c');
---
<Fragment set:html={head} />
<section id="catalog">
    <div class="kicker"><span class="en">{intro.kicker.en}</span><span class="es">{intro.kicker.es}</span></div>
    <h2 class="section"><span class="en">{intro.heading.en}</span><span class="es">{intro.heading.es}</span></h2>
    <p><span class="en">{intro.lead.en}</span>
    <span class="es">{intro.lead.es}</span></p>
    <div class="foundation-first">
      <h3><span class="en">Start Here: The Seven Foundation Courses</span><span class="es">Comience Aquí: los Siete Cursos de Fundamento</span></h3>
      <p><span class="en">Every student begins with these seven, in any order. The rest of the catalog opens once they are complete.</span><span class="es">Todo estudiante comienza con estos siete, en cualquier orden. El resto del catálogo se abre al completarlos.</span></p>
      <div class="grid">
        {foundation.map((c) => (
        <a class="fcard" href={c!.entry}><div class="c-title"><span class="en">{c!.title.en}</span><span class="es">{c!.title.es}</span></div><div class="c-desc"><span class="en">{c!.description.en}</span><span class="es">{c!.description.es}</span></div></a>
        ))}
      </div>
    </div>
    <div class="catsub">
      <h3><span class="en">All Courses by Subject</span><span class="es">Todos los Cursos por Materia</span></h3>
      <p><span class="en">Open a group to see its courses.</span><span class="es">Abra un grupo para ver sus cursos.</span></p>
    </div>
{byGroup.map((g) => (<>
    {g.id === firstElective && (
    <div class="catsub">
      <h3><span class="en">Denominational Electives</span><span class="es">Electivas Denominacionales</span></h3>
      <p><span class="en">Twenty electives in four traditions, five courses in each.</span><span class="es">Veinte electivas en cuatro tradiciones, cinco cursos en cada una.</span></p>
    </div>
    )}
    <div class="catgroup"><details class="catfold" id={`group-${g.id}`}>
      <summary><h3><span class="en">{g.title.en}</span><span class="es">{g.title.es}</span></h3><span class="catcount">{g.courses.length}</span></summary>
      <div class="grid">
        {g.courses.map((c) => (
        <a class="course" href={c.entry}><div class="c-title"><span class="en">{c.title.en}</span><span class="es">{c.title.es}</span></div><div class="c-desc"><span class="en">{c.description.en}</span><span class="es">{c.description.es}</span></div><span class="c-go"><span class="en">Begin →</span><span class="es">Comenzar →</span></span></a>
        ))}
      </div>
    </details></div>
</>))}
  </section>
<section id="library">
    <div class="kicker"><span class="en">Textbooks, Readings and Resources</span><span class="es">Libros, Lecturas y Recursos</span></div>
    <h2 class="section"><span class="en">Study Library</span><span class="es">Biblioteca de Estudio</span></h2>
    <p><span class="en">The textbook and required readings for each course, each with a link to its test, are listed in the Study Library, together with Reading With Honors and our free study resources.</span><span class="es">El libro de texto y las lecturas requeridas de cada curso, cada uno con un enlace a su examen, están en la Biblioteca de Estudio, junto con la Lectura Con Honores y nuestros recursos de estudio gratuitos.</span></p>
    <div class="lib-links">
      <a class="cta" href="CTSStudyLibrary.html"><span class="en">Open the Study Library →</span><span class="es">Abrir la Biblioteca de Estudio →</span></a>
      <a href="CTSStudyLibrary.html#honors-note"><span class="en">Reading With Honors</span><span class="es">Lectura Con Honores</span></a>
      <a href="CTSResources.html"><span class="en">Study Resources</span><span class="es">Recursos de Estudio</span></a>
    </div>
  </section>
<script is:inline src="/assets/js/cts-record.js"></script>
<script is:inline set:html={`window.CTSRecord && window.CTSRecord.backfill(${recordJson});`} />
<Fragment set:html={tail} />
