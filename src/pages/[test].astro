---
/* The textbook test, on a page of its own: CTSTextbookCultsTest.html and the
 * other eight. Twenty fill-in-the-blank questions drawn at random from the
 * book's forty, eighteen right to pass (Dr. Cook, 3 Oct 2026), marked by the
 * same grader as every unit's fill-ins (public/assets/js/cts-fill.js:
 * capitals, accents and punctuation do not count). The book is not on this
 * page, so the browser's Find cannot search it for an answer. The page's own
 * script is public/assets/js/cts-textbook.js. */
import { getCollection } from 'astro:content';
import Textbook from '../layouts/Textbook.astro';
import catalog from '../../worker/catalog.json';
import { testsOfCourseWith, unitCourseWith } from '../lib/required-tests.ts';
import { frBookTitle } from '../lib/french-titles.ts';
import { live, liveBank } from '../lib/grading-mode';

export async function getStaticPaths() {
  const books = await getCollection('textbooks');
  const courses = await getCollection('courses');
  const units = await getCollection('units');
  const card = new Map(courses.map((c) => [c.id, c.data]));
  const slugOf = new Map(units.map((u) => [u.data.pagePrefix, u.data.course]));
  return books.map((b) => {
    const course = card.get(b.data.course);
    if (!course) throw new Error(`textbook ${b.data.slug} belongs to course "${b.data.course}", which has no catalog card`);
    return { params: { test: `${b.data.page}Test` }, props: { book: b.data, course, accent: slugOf.get(b.data.course) ?? null } };
  });
}
const { book, course, accent } = Astro.props;
const { draw, pass, questions } = book.test;
/* What a pass completes: on the master's tracks the course waits for this
   test (public/assets/js/cts-record.js). From worker/catalog.json, the same
   map the Worker applies. A unit course is recorded by its units; a
   single-page course by its own completion code. */
const tb = (catalog.textbooks as Record<string, { code: string }>)[book.slug];
const unitCourse = unitCourseWith(book.slug);
const done = (catalog.completions as Record<string, { name: string; page: string }>)[tb.code];
/* Every test the course requires, this one among them: passing one is not
   passing the other (9 Oct 2026), so a pass here completes the course only
   when nothing else is still to pass. */
const tests = testsOfCourseWith(book.slug);
const completion = unitCourse
  ? { slug: unitCourse[0], code: tb.code, name: done.name, page: done.page, units: unitCourse[1].units, textbook: book.slug, ...(tests.length > 1 ? { tests } : {}) }
  : { single: true, code: tb.code, name: done.name, page: done.page, textbook: book.slug, ...(tests.length > 1 ? { tests } : {}) };
/* Live mode: the bank carries prompts and ids only; the server draws the
   twenty and grades them (docs/ai-grading.md). */
const shown = live ? liveBank({ slug: book.slug, questions }) : null;
const data = JSON.stringify({ slug: book.slug, page: book.page, title: book.title, draw, pass, questions: shown ? shown.questions : questions, completion,
  ...(shown ? { grading: 'live', scope: shown.scope } : {}),
  ...(book.test.perChapter ? { perChapter: book.test.perChapter } : {}),
  ...(book.test.revision ? { revision: book.test.revision } : {}),
  ...(book.test.resetWaitOnRevision ? { resetWaitOnRevision: true } : {}),
  ...('requiredFrom' in book ? { requiredFrom: book.requiredFrom } : {}) }).replace(/</g, '\\u003c');
---
<Textbook kind="test" book={{ ...book, title: { ...book.title, fr: frBookTitle(book.title.en) } }} course={course} accent={accent} scripts={['/assets/js/cts-fill.js', '/assets/js/cts-required-tests.js', '/assets/js/cts-record.js']} sync={true}>
  <section class="card tb-about" data-cts-chrome>
    <h2><span class="lang-en">Textbook test</span><span class="lang-es">Examen del libro de texto</span><span class="lang-fr">Examen du manuel</span></h2>
    <p>
      <span class="lang-en">Twenty fill-in-the-blank questions, drawn at random from forty, on <em>{book.title.en}</em>. You need {pass} of {draw} to pass. Type the missing word or phrase and press Check (or Enter): each answer is marked at once. Capitals, accents and punctuation do not matter; you may answer in English or Spanish. If you fall short, review the book and try again after a short wait; the next attempt draws a fresh twenty.</span>
      <span class="lang-es">Veinte preguntas para completar, tomadas al azar de cuarenta, sobre <em>{book.title.es}</em>. Necesita {pass} de {draw} para aprobar. Escriba la palabra o frase que falta y pulse Comprobar (o Intro): cada respuesta se califica en seguida. No importan las mayúsculas, los acentos ni la puntuación; puede responder en inglés o en español. Si no alcanza la nota, repase el libro e inténtelo de nuevo tras una breve espera; el siguiente intento toma otras veinte.</span>
      <span class="lang-fr">Vingt questions à compléter, tirées au hasard parmi quarante, sur <em>{frBookTitle(book.title.en)}</em>. Il faut {pass} bonnes réponses sur {draw} pour réussir. Saisissez le mot ou l’expression qui manque, puis appuyez sur Vérifier (ou Entrée) : chaque réponse est corrigée aussitôt. Les majuscules, les accents et la ponctuation ne comptent pas. Vous pouvez répondre en français lorsque la question existe en français ; une question encore en anglais attend une réponse en anglais. Si vous n’atteignez pas le score requis, relisez le manuel et réessayez après une courte attente ; la tentative suivante tire vingt nouvelles questions.</span>
    </p>
    <p class="small muted">
      <span class="lang-en">The book is not on this page: <a href={`/${book.page}.html`}>read it first</a>, then come back.</span>
      <span class="lang-es">El libro no está en esta página: <a href={`/${book.page}.html`}>léalo primero</a> y luego vuelva.</span>
      <span class="lang-fr">Le manuel n’est pas sur cette page : <a href={`/${book.page}.html`}>lisez-le d’abord</a>, puis revenez.</span>
    </p>
  </section>

  <section class="card tb-test" id="tb-test">
    <div id="tb-status" role="status"></div>
    <div id="tb-questions"></div>
    <div class="actions" data-cts-chrome>
      <button type="button" class="btn solid" id="tb-submit"><span class="lang-en">Submit the test</span><span class="lang-es">Enviar el examen</span><span class="lang-fr">Envoyer l’examen et voir le résultat</span></button>
      <button type="button" class="btn secondary" id="tb-reset"><span class="lang-en">Clear my answers</span><span class="lang-es">Borrar mis respuestas</span><span class="lang-fr">Recommencer l’examen</span></button>
    </div>
    <div id="tb-result" style="margin-top:15px;font-weight:bold;"></div>
  </section>

  <script is:inline set:html={`window.CTS_TEXTBOOK_TEST = ${data};`} />
</Textbook>
