---
/* The required-reading test, on a page of its own: CTSGenesisReadingsTest.html
 * and CTSWRRequiredTest.html (Dr. Cook's "CTS Add-ons", 4 Oct 2026). The same
 * test as a Master's textbook's -- twenty fill-in-the-blank questions drawn at
 * random from forty, eighteen right to pass, marked by cts-fill.js -- but on
 * the course's required readings, which are on the room page, not here, so
 * the browser's Find cannot search them for an answer. On the M.Div. and
 * Th.M. tracks the course waits for this pass; Certificate and Associate
 * students may take it as a learning opportunity. The page's own script is
 * public/assets/js/cts-textbook.js, which reads `kind` and says "readings"
 * where it would say "book". */
import { getCollection } from 'astro:content';
import Textbook from '../layouts/Textbook.astro';
import catalog from '../../worker/catalog.json';
import { testsOfCourseWith, unitCourseWith } from '../lib/required-tests.ts';
import { frReadingsTitle, frReadingsRoom } from '../lib/french-titles.ts';
import { live, liveBank } from '../lib/grading-mode';
import { readingQuestions } from '../../tools/grading-keys-lib.mjs';

export async function getStaticPaths() {
  const tests = await getCollection('readings');
  const courses = await getCollection('courses');
  const units = await getCollection('units');
  const card = new Map(courses.map((c) => [c.id, c.data]));
  const slugOf = new Map(units.map((u) => [u.data.pagePrefix, u.data.course]));
  return tests.map((r) => {
    const course = card.get(r.data.course);
    if (!course) throw new Error(`required readings ${r.data.slug} belong to course "${r.data.course}", which has no catalog card`);
    return { params: { readingtest: `${r.data.page}Test` }, props: { reading: r.data, course, accent: slugOf.get(r.data.course) ?? null } };
  });
}
const { reading, course, accent } = Astro.props;
const { draw, pass, questions, perGroup, revision } = reading.test;
/* A bank drawn by reading (World Religions, revised 10 Oct 2026): perGroup
   from each reading, said so on the page, and the revision cts-textbook.js
   checks before it resumes an attempt. */
const groups = perGroup ? new Set(questions.map((q) => q.group)).size : 0;
/* What a pass completes, from worker/catalog.json: the one map the Worker
   applies (the test sits in `textbooks` with kind "reading"). */
const tb = (catalog.textbooks as Record<string, { code: string; kind: string }>)[reading.slug];
const unitCourse = unitCourseWith(reading.slug);
if (!tb) throw new Error(`worker/catalog.json does not carry the required readings ${reading.slug}: run node tools/gen-worker-catalog.mjs`);
const done = (catalog.completions as Record<string, { name: string; page: string }>)[tb.code];
/* Every test the course requires, this one among them (9 Oct 2026): a pass
   here completes the course only when nothing else is still to pass. */
const tests = testsOfCourseWith(reading.slug);
const dated = tests.length > 1 || tests.some((t) => 'requiredFrom' in t);
/* A single-page course (Preaching) has no unit record: the test page names
   the course by its code, as the textbook test pages do for Counseling, and
   the course's own page goes on recording its completion (cts-record.js). */
const completion = unitCourse
  ? { slug: unitCourse[0], code: tb.code, name: done.name, page: done.page, units: unitCourse[1].units, textbook: reading.slug, textbookKind: 'reading', textbookPage: reading.page, ...(dated ? { tests } : {}) }
  : { single: true, code: tb.code, name: done.name, page: done.page, textbook: reading.slug, textbookKind: 'reading', textbookPage: reading.page, ...(dated ? { tests } : {}) };
const book = { slug: reading.slug, page: reading.page, course: reading.course, title: { ...reading.title, fr: frReadingsTitle(reading.course) }, edition: 'readings' };
const roomFr = frReadingsRoom(reading.course, reading.page);
const perReading = reading.test.perReading ?? null;
const pending = 'requiredFrom' in reading && reading.requiredFrom == null;
const from = reading.requiredFrom ? new Date(reading.requiredFrom) : null;
const fromText = from ? { en: from.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }),
                          es: from.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }),
                          fr: from.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) } : null;
/* Live mode ships no question bank; the server sends the drawn prompts.
   Shadow mode still embeds the bank. See src/pages/[test].astro. A private
   bank (keys: "private") has no answers in its public file: in shadow mode
   they are joined from the assessment-keys checkout, and the build stops
   without it. A public bank is embedded as it is. */
const shown = live ? liveBank({ slug: reading.slug, kind: 'reading', questions }) : null;
const shadowBank = live ? null : readingQuestions('.', reading, (m) => console.warn(m)).questions;
const data = JSON.stringify({ slug: reading.slug, page: reading.page, kind: 'reading', title: reading.title, draw, pass, questions: shown ? [] : shadowBank, completion,
  ...(shown ? { grading: 'live', scope: shown.scope } : {}),
  ...(reading.test.resetWaitOnRevision ? { resetWaitOnRevision: true } : {}),
  ...(perGroup ? { perGroup } : {}), ...(revision ? { revision } : {}), ...(perReading ? { perReading } : {}), ...('requiredFrom' in reading ? { requiredFrom: reading.requiredFrom ?? null } : {}) }).replace(/</g, '\\u003c');
---
<Textbook kind="reading-test" book={book} course={course} accent={accent} scripts={['/assets/js/cts-fill.js', '/assets/js/cts-required-tests.js', '/assets/js/cts-record.js']} sync={true}>
  <section class="card tb-about" data-cts-chrome>
    <h2><span class="lang-en">Required-reading test</span><span class="lang-es">Examen de lecturas requeridas</span><span class="lang-fr">Examen des lectures obligatoires</span></h2>
    <p>
      <span class="lang-en">Twenty fill-in-the-blank questions, drawn at random from forty{(perReading || perGroup) ? ` — ${perReading || perGroup} from each of the five readings —` : ','} on {reading.room.en}. You need {pass} of {draw} to pass. Type the missing word or phrase and press Check (or Enter): each answer is marked at once. Capitals, accents and punctuation do not matter; you may answer in English or Spanish. If you fall short, go back to the readings and try again after a short wait; the next attempt draws a fresh twenty.</span>
      <span class="lang-es">Veinte preguntas para completar, tomadas al azar de cuarenta{(perReading || perGroup) ? ` — ${perReading || perGroup} de cada una de las cinco lecturas —` : ','} sobre {reading.room.es}. Necesita {pass} de {draw} para aprobar. Escriba la palabra o frase que falta y pulse Comprobar (o Intro): cada respuesta se califica en seguida. No importan las mayúsculas, los acentos ni la puntuación; puede responder en inglés o en español. Si no alcanza la nota, vuelva a las lecturas e inténtelo de nuevo tras una breve espera; el siguiente intento toma otras veinte.</span>
      <span class="lang-fr">Vingt questions à compléter, tirées au hasard parmi quarante{(perReading || perGroup) ? ` — ${perReading || perGroup} pour chacune des cinq lectures —` : ','} sur {roomFr}. Il faut {pass} bonnes réponses sur {draw} pour réussir. Saisissez le mot ou l’expression qui manque, puis appuyez sur Vérifier (ou Entrée) : chaque réponse est corrigée aussitôt. Les majuscules, les accents et la ponctuation ne comptent pas. Vous pouvez répondre en français lorsque la question existe en français ; une question encore en anglais attend une réponse en anglais. Si vous n’atteignez pas le score requis, relisez les lectures et réessayez après une courte attente ; la tentative suivante tire vingt nouvelles questions.</span>
    </p>
    {pending ? (
    <p>
      <span class="lang-en">This test is being introduced for the M.Div. and Th.M. tracks and is not yet required: the seminary will announce when it begins to count. Until then any student may take it; a pass is kept in your record and will count when it does.</span>
      <span class="lang-es">Este examen se está introduciendo para los trayectos M.Div. y Th.M. y aún no es obligatorio: el seminario anunciará cuándo empieza a contar. Mientras tanto cualquier estudiante puede presentarlo; la aprobación queda en su registro y contará cuando así sea.</span>
      <span class="lang-fr">Cet examen est en cours d’introduction pour les parcours M.Div. et Th.M. et n’est pas encore obligatoire : le séminaire annoncera le moment où il commencera à compter. D’ici là, tout étudiant peut le passer ; une réussite est conservée dans votre dossier et comptera le moment venu.</span>
    </p>
    ) : (
    <p>
      <span class="lang-en">On the M.Div. and Th.M. tracks this test is required: the course is complete when its units{tests.length > 1 ? ', its textbook test' : ''} and this test are passed.{fromText ? ` It counts from ${fromText.en}; a master's completion of the course already in your record before then stands as it is.` : ''} Certificate and Associate students may take it too, as a learning opportunity; nothing of theirs depends on it.</span>
      <span class="lang-es">En los trayectos M.Div. y Th.M. este examen es obligatorio: el curso se completa cuando se aprueban sus unidades{tests.length > 1 ? ', el examen del libro de texto' : ''} y este examen.{fromText ? ` Cuenta desde el ${fromText.es}; una finalización de maestría del curso que ya estaba en su registro antes de esa fecha queda como está.` : ''} Los estudiantes de Certificado y Asociado también pueden presentarlo, como oportunidad de aprendizaje; nada de lo suyo depende de él.</span>
      <span class="lang-fr">Pour les parcours M.Div. et Th.M., cet examen est obligatoire : le cours est terminé lorsque ses unités{tests.length > 1 ? ', l’examen du manuel' : ''} et cet examen sont réussis.{fromText ? ` Il compte à partir du ${fromText.fr} ; une validation de niveau master déjà inscrite dans votre dossier avant cette date reste acquise.` : ''} Les étudiants des parcours Certificat et diplôme associé peuvent aussi le passer, pour apprendre ; rien de leur parcours n’en dépend.</span>
    </p>
    )}
    <p class="small muted">
      <span class="lang-en">The readings are not on this page: <a href={`/${reading.page}.html`}>read them first</a>, then come back.</span>
      <span class="lang-es">Las lecturas no están en esta página: <a href={`/${reading.page}.html`}>léalas primero</a> y luego vuelva.</span>
      <span class="lang-fr">Les lectures ne sont pas sur cette page : <a href={`/${reading.page}.html`}>lisez-les d’abord</a>, puis revenez.</span>
    </p>
  </section>

  <section class="card tb-test" id="tb-test">
    <div id="tb-status" role="status"></div>
    <div id="tb-questions"></div>
    <div class="actions" data-cts-chrome>
      <button type="button" class="btn solid" id="tb-submit"><span class="lang-en">Submit the test</span><span class="lang-es">Enviar el examen</span><span class="lang-fr">Envoyer l’examen et voir le résultat</span></button>
      <button type="button" class="btn secondary" id="tb-reset"><span class="lang-en">Clear my answers</span><span class="lang-es">Borrar mis respuestas</span><span class="lang-fr">Recommencer l’examen</span></button>
    </div>
    <div id="tb-result" style="margin-top:15px;font-weight:bold;"></div>
  </section>

  <script is:inline set:html={`window.CTS_TEXTBOOK_TEST = ${data};`} />
</Textbook>
