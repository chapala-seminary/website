---
/* A Master's textbook, read on the site: CTSTextbookCults.html and the other
 * eight. The book's own text, both languages, from src/content/textbooks
 * (made from the Word masters by tools/import-textbooks.mjs), with a contents
 * list, the PDFs to download, and the way to its test -- which is a separate
 * page, so this one can be searched freely. */
import { getCollection } from 'astro:content';
import Textbook from '../layouts/Textbook.astro';
import { frTextbookTitle } from '../lib/french-titles.ts';
import EditorialNotice from '../components/EditorialNotice.astro';
import { DICTIONARY_LANGUAGES } from '../lib/languages.mjs';

export async function getStaticPaths() {
  const books = await getCollection('textbooks');
  const courses = await getCollection('courses');
  const units = await getCollection('units');
  const card = new Map(courses.map((c) => [c.id, c.data]));
  // the course's storage slug ("cults"), which keys its colour; the two
  // single-page courses have no units and take the default
  const slugOf = new Map(units.map((u) => [u.data.pagePrefix, u.data.course]));
  return books.map((b) => {
    const course = card.get(b.data.course);
    if (!course) throw new Error(`textbook ${b.data.slug} belongs to course "${b.data.course}", which has no catalog card in src/content/courses`);
    return { params: { textbook: b.data.page }, props: { book: b.data, course, accent: slugOf.get(b.data.course) ?? null } };
  });
}
const { book, course, accent } = Astro.props;

// the contents, from the headings the importer gave ids to
const toc = (html: string) =>
  [...html.matchAll(/<(h2|h3) id="([^"]+)">([\s\S]*?)<\/\1>/g)]
    .map((m) => ({ level: m[1], id: m[2], text: m[3].replace(/<[^>]+>/g, '') }));
const contents = { en: toc(book.body.en), es: toc(book.body.es), fr: book.body.fr ? toc(book.body.fr) : null };
// a later language's book (Swahili first): its own article and contents, shown only on its pages
const later = DICTIONARY_LANGUAGES.filter((l) => book.body[l]).map((l) => ({ lang: l, body: book.body[l], contents: toc(book.body[l]) }));
const web = ('html' in book.files ? book.files.html : undefined);
const pdf = ('pdf' in book.files ? book.files.pdf : undefined);
// assigned readings (excerpts or whole chapters): the body of this page, in both languages
const excerpts = ('excerpts' in book.files);
---
<Textbook kind="book" book={{ ...book, title: { ...book.title, fr: frTextbookTitle(book) } }} course={course} accent={accent}>
  {book.slug === 'joshua' && <EditorialNotice kind="blaikie" />}
  <section class="card tb-about" data-cts-chrome>
    <h2><span class="lang-en">About this textbook</span><span class="lang-es">Sobre este libro de texto</span><span class="lang-fr">À propos de ce manuel</span></h2>
    <p hidden={!!web || excerpts}>
      <span class="lang-en">This is the textbook for <a href={`/${course.entry}`}>{course.title.en}</a>. It is required reading for students on the M.Div. and Th.M. tracks, and open to everyone. Read it here in English or Spanish, or download it as a PDF. When you have read it, take the textbook test: twenty fill-in-the-blank questions, drawn from forty, on a page of its own.</span>
      <span class="lang-es">Este es el libro de texto del curso <a href={`/${course.entry}`}>{course.title.es}</a>. Es lectura obligatoria para los estudiantes de los trayectos M.Div. y Th.M., y está abierto a todos. Léalo aquí en inglés o en español, o descárguelo en PDF. Cuando lo haya leído, presente el examen del libro: veinte preguntas para completar, tomadas de cuarenta, en una página aparte.</span>
      <span class="lang-fr">Voici le manuel du cours <a href={`/${course.entry}`}>{course.title.fr}</a>. Sa lecture est obligatoire pour les étudiants des parcours M.Div. et Th.M., et il est ouvert à tous. Lisez-le ici en anglais{book.body.fr ? ', en espagnol ou en français' : ' ou en espagnol'}, ou téléchargez-le au format PDF. Après l’avoir lu, passez l’examen du manuel : vingt questions à compléter, tirées parmi quarante, sur une page à part.</span>
    </p>
    {(web || excerpts) && <p>
      {web
        ? <><span class="lang-en">Read the original English book or the CTS Spanish translation of the assigned chapters on the seminary website.</span><span class="lang-es">Lea el libro original completo en inglés o la traducción del STC de los capítulos asignados en español dentro del sitio del seminario.</span><span class="lang-fr">{web.fr ? 'Lisez sur le site du séminaire le livre original complet en anglais, ou les chapitres assignés traduits par le STC en espagnol et en français.' : 'Lisez sur le site du séminaire le livre original complet en anglais, ou la traduction espagnole des chapitres assignés réalisée par le STC.'}</span></>
        : <><span class="lang-en">The assigned readings from this book are on this page, in English and in a CTS Spanish translation.</span><span class="lang-es">Las lecturas asignadas de este libro están en esta página, en inglés y en una traducción al español del STC.</span><span class="lang-fr">{book.body.fr ? 'Les lectures assignées de ce livre se trouvent sur cette page, en anglais et dans des traductions espagnole et française réalisées par le STC.' : 'Les lectures assignées de ce livre se trouvent sur cette page, en anglais et dans une traduction espagnole réalisée par le STC.'}</span></>}
      {' '}
      {book.requiredFrom
        ? <><span class="lang-en">Students on the M.Div. and Th.M. tracks must read them and pass the textbook test (twenty fill-in-the-blank questions) to complete the course; it is open to everyone.</span><span class="lang-es">Los estudiantes de los trayectos M.Div. y Th.M. deben leerlas y aprobar el examen del libro (veinte preguntas para completar) para completar el curso; está abierto a todos.</span><span class="lang-fr">Les étudiants des parcours M.Div. et Th.M. doivent les lire et réussir l’examen du manuel (vingt questions à compléter) pour terminer le cours ; il est ouvert à tous.</span></>
        : <><span class="lang-en">The test page explains when this examination is required for master’s course completion. Valid earlier completions remain valid.</span><span class="lang-es">La página del examen explica cuándo se exige para completar el curso de maestría. Las finalizaciones válidas anteriores siguen siendo válidas.</span><span class="lang-fr">La page de l’examen explique quand il est obligatoire pour valider le cours au niveau master. Les validations antérieures restent acquises.</span></>}
    </p>}
    {book.slug === 'doctrines' && <p data-cts-excerpt-notice>
      <span class="lang-en">This assignment contains five selected excerpts, not the complete book. The examination covers these excerpts only. For optional further study, <a href="https://www.gutenberg.org/ebooks/52648" target="_blank" rel="noopener">read Torrey’s complete original book in English</a>.</span>
      <span class="lang-es">Esta tarea contiene cinco fragmentos seleccionados, no el libro completo. El examen abarca solo estos fragmentos. Para profundizar de forma opcional, <a href="https://www.gutenberg.org/ebooks/52648" target="_blank" rel="noopener">lea el libro original completo de Torrey en inglés</a>.</span>
      <span class="lang-fr">Ce travail comprend cinq extraits choisis, et non le livre intégral. L’examen porte uniquement sur ces extraits. Pour approfondir à titre facultatif, <a href="https://www.gutenberg.org/ebooks/52648" target="_blank" rel="noopener">lisez le livre original intégral de Torrey en anglais</a>.</span>
    </p>}
    <div class="actions tb-actions">
      <a class="btn solid" href={`/${book.page}Test.html`}><span class="lang-en">Take the textbook test</span><span class="lang-es">Presentar el examen del libro</span><span class="lang-fr">Passer l’examen du manuel</span> →</a>
      {web ? (
        <>
          <a class="btn" href={`/${web.en}`}><span class="lang-en">Full book (English)</span><span class="lang-es">Libro completo (inglés)</span><span class="lang-fr">Livre complet (anglais)</span></a>
          <a class="btn" href={`/${web.es}`}><span class="lang-en">Assigned chapters (Spanish)</span><span class="lang-es">Capítulos asignados (español)</span><span class="lang-fr">Chapitres assignés (espagnol)</span></a>{web.fr && <a class="btn lang-fr" href={`/${web.fr}`}>Chapitres assignés (français)</a>}
        </>
      ) : excerpts ? null : (
        <>
          <a class="btn" href={`/${pdf?.en}`} download><span class="lang-en">PDF (English)</span><span class="lang-es">PDF (inglés)</span><span class="lang-fr">PDF (anglais)</span></a>
          <a class="btn" href={`/${pdf?.es}`} download><span class="lang-en">PDF (Spanish)</span><span class="lang-es">PDF (español)</span><span class="lang-fr">PDF (espagnol)</span></a>
        </>
      )}
    </div>
    <p class="small muted" id="tb-passed-note" hidden></p>
  </section>

  <nav class="card tb-toc" aria-label="Contents">
    <h2 data-cts-chrome><span class="lang-en">Contents</span><span class="lang-es">Contenido</span><span class="lang-fr">Sommaire</span></h2>
    <ol class="lang-en">
      {contents.en.map((c) => <li class={c.level === 'h3' ? 'l3' : 'l2'}><a href={`#${c.id}`}>{c.text}</a></li>)}
    </ol>
    <ol class="lang-es">
      {contents.es.map((c) => <li class={c.level === 'h3' ? 'l3' : 'l2'}><a href={`#${c.id}`}>{c.text}</a></li>)}
    </ol>{contents.fr && <ol class="lang-fr">
      {contents.fr.map((c) => <li class={c.level === 'h3' ? 'l3' : 'l2'}><a href={`#${c.id}`}>{c.text}</a></li>)}
    </ol>}{later.map((x) => <ol class={`lang-${x.lang}`}>
      {x.contents.map((c) => <li class={c.level === 'h3' ? 'l3' : 'l2'}><a href={`#${c.id}`}>{c.text}</a></li>)}
    </ol>)}
  </nav>

  <article class="card tb-book lang-en" lang="en" set:html={book.body.en} />
  <article class="card tb-book lang-es" lang="es" set:html={book.body.es} />{book.body.fr && <article class="card tb-book lang-fr" lang="fr" set:html={book.body.fr} />}{later.map((x) => <article class={`card tb-book lang-${x.lang}`} lang={x.lang} set:html={x.body} />)}

  <p class="small muted tb-edition" data-cts-chrome>
      {excerpts ? <><span class="lang-en">Assigned readings from a historical public-domain edition ({book.edition}); the Spanish is a CTS translation.</span><span class="lang-es">Lecturas asignadas de una edición histórica de dominio público ({book.edition}); el español es una traducción del STC.</span><span class="lang-fr">Lectures assignées tirées d’une édition historique du domaine public ({book.edition}) ; {book.body.fr ? 'l’espagnol et le français sont des traductions du STC.' : 'l’espagnol est une traduction du STC.'}</span></> : web ? <><span class="lang-en">Historical public-domain edition; the CTS Spanish assigned chapters are linked above.</span><span class="lang-es">Edición histórica de dominio público; arriba se enlazan los capítulos asignados traducidos por el STC.</span><span class="lang-fr">{web.fr ? 'Édition historique du domaine public ; les chapitres assignés traduits par le STC en espagnol et en français sont indiqués ci-dessus.' : 'Édition historique du domaine public ; les chapitres assignés traduits en espagnol par le STC sont indiqués ci-dessus.'}</span></> : <><span class="lang-en">CTS Textbook Edition {book.edition}. The Word file is the master; this page was made from it.</span><span class="lang-es">Edición de libro de texto CTS {book.edition}. El archivo de Word es el original; esta página se hizo a partir de él.</span><span class="lang-fr">Édition STC du manuel {book.edition}. Le fichier Word fait foi ; cette page a été produite à partir de lui.</span></>}
  </p>
</Textbook>
