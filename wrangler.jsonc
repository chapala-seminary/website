{
	// The seminary, as a Worker with static assets.
	//
	// NOT Cloudflare Pages. Pages answers /CTSActsUnit3.html with a 308 to
	// /CTSActsUnit3 and offers no way to turn that off. Every one of the 801
	// pages here ends in .html, 8,878 links between them do too, and the Astro
	// config sets `build.format: 'file'` for the sole purpose of keeping those
	// URLs exactly as students and search engines already have them. See
	// worker/index.js.
	//
	// DEPLOYING
	//   npx wrangler deploy                 -> chapalaseminary.org
	//   npx wrangler deploy --env beta      -> beta.chapalaseminary.org
	//
	// WHICH CLOUDFLARE ACCOUNT
	//
	// account_id is pinned, and that is not housekeeping. This repository is
	// worked on from a machine that has access to two Cloudflare accounts, and
	// wrangler with no account_id picks one for you. The first `d1 create` went
	// to the wrong account. A database in the wrong account is a minute's
	// cleanup; `wrangler deploy` in the wrong account publishes the seminary
	// into somebody else's, which is a different kind of afternoon.
	//
	// 119b0919229edb3185b69f1c6bd04b66 is the Chapala account. The personal
	// login on this machine is a member of it, so one login reaches both
	// accounts and this pin is what picks the right one. `npm run deploy`
	// checks that the credentials in use actually reach the account named here
	// before it publishes anything.
	//
	// A WARNING ABOUT `wrangler d1 create`
	//
	// It edits this file. It appends a new binding to the TOP-LEVEL
	// d1_databases -- under its own name, not "DB", and regardless of which
	// environment the database is for -- and reformats everything while it is
	// there. So after creating a database: take the id it printed, put it in
	// the right place below, and delete the block it added.
	// tools/verify-worker-config.mjs fails until that is done.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chapala-seminary",
	// Existing production probe hostname: Bot Fight Mode can challenge CI on the custom domain.
	"workers_dev": true,
	"preview_urls": false,
	"account_id": "119b0919229edb3185b69f1c6bd04b66",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-01",
	"observability": {
		"enabled": true
	},
	// Outgoing email (worker/email.js): Cloudflare Email Service through this
	// binding, with Resend kept as the fallback. The domain must be onboarded
	// once (Compute > Email Service > Email Sending) before the binding reaches
	// students. Resend's key stays a secret, never here:
	//   npx wrangler secret put RESEND_API_KEY            (production)
	//   npx wrangler secret put RESEND_API_KEY --env beta (beta)
	"send_email": [{ "name": "EMAIL" }],
	// AI grading of written answers (worker/grading/, docs/ai-grading.md).
	// Workers AI runs the models on Cloudflare's own machines; there is no key.
	// Workers Paid is required (Robert, 14 Oct 2026): on the free plan grading
	// would stop for the day once the daily allowance ran out.
	"ai": { "binding": "AI" },
	"vars": {
		// "live": the server is the grader of record (docs/ai-grading.md section 1).
		// Wayne approved switching production from the shadow trial on 19 Oct 2026.
		"GRADING_MODE": "live",
		// Until this time, passes still held only in a student's browser from
		// before the switch are taken by /api/sync as legacy credit (first
		// completions only, never a higher level): worker/grading/mode.js.
		// Sixty days from the switch. Remove or leave in the past to close it.
		"LEGACY_SYNC_UNTIL": "2026-12-20T00:00:00.000Z",
		// ...and only for records registered before this time: set it to the
		// day production switches to live (no later), so a record made under
		// live grading can never bring browser credit.
		"LEGACY_SYNC_COHORT_BEFORE": "2026-10-20T18:10:35.000Z",
		"GRADER_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		"GRADER_MODEL_FALLBACK": "@cf/openai/gpt-oss-120b",
		"GRADER_PROMPT_VERSION": "2026-10-19.1",
		// Production release cutoff: preserve this date on later deployments.
		"MASTER_TESTS_ACTIVATION": "2026-10-15T05:17:56.813Z",
		"EMAIL_FROM": "Chapala Theological Seminary <certificates@chapalaseminary.org>",
		"EMAIL_REPLY_TO": "info@chapalaseminary.org",
		// where the seminary is told of completions and certificates (worker/notify.js)
		"NOTIFY_TO": "info@chapalaseminary.org",
		// notes to students who have gone quiet (worker/outreach.js):
		// "send" to write to them, anything else to write to nobody
		"OUTREACH_MODE": "send",
		// the Monday summary to the seminary: "send" to email it
		"DIGEST_MODE": "send",
		"OUTREACH_FROM": "Wayne Cook at Chapala Theological Seminary <certificates@chapalaseminary.org>",
		"SITE_ORIGIN": "https://chapalaseminary.org",
		// The staff pages (worker/staff.js): Cloudflare Access, team domain
		// chapalatheological.cloudflareaccess.com, and the audience tag of the
		// Access application covering /staff on chapalaseminary.org and
		// beta.chapalaseminary.org (docs/student-tracker.md). Not secrets: they
		// say which sign-in to trust, and grant nothing on their own.
		"ACCESS_TEAM": "chapalatheological",
		"ACCESS_AUD": "debf55802de573c5790f05b163c141178b068b01ee8c84ef0ed14c26224bb25c"
		// Coordinator pages (/coord) use a second Access application. Leave
		// COORD_ACCESS_AUD unset until that application exists: /coord then
		// answers "not set up". When it is set it must be a different audience
		// than ACCESS_AUD (docs/coordinator-setup.md).
	},
	// Once a day at 15:00 UTC (9:00 in Mexico City): notes to students who have
	// gone quiet, and on Mondays the seminary's weekly summary. And every 15
	// minutes: the answers waiting to be graded (worker/grading/queue.js).
	"triggers": {
		"crons": ["0 15 * * *", "*/15 * * * *"]
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// "none": no rewriting of any kind. /CTSActsUnit3.html is served as
		// asked. It also means "/" is not resolved to "/index.html", so the
		// Worker does that itself -- visibly, and checked by
		// tools/verify-worker-routing.mjs.
		"html_handling": "none",
		"not_found_handling": "none",
		// Every request goes through the Worker, assets included. With the
		// default (false) the assets are served without the Worker ever running,
		// and the staging guard in worker/index.js would protect nothing: the
		// HTML pages, which are the entire indexing problem, would go straight
		// out with no header on them.
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "chapala-students",
			"database_id": "88a0b667-c2a6-4598-8779-0eb8970ae10d"
		}
	],
	"env": {
		// beta.chapalaseminary.org. Same code, same assets, its own database --
		// so that registering a test student while checking the site cannot
		// leave a row in the real students' table.
		"beta": {
			"name": "chapala-seminary-beta",
			// Keep the direct hostname used by the post-deploy health fallback.
			// Routes otherwise make Wrangler default workers_dev to false.
			"workers_dev": true,
			"preview_urls": false,
			"account_id": "119b0919229edb3185b69f1c6bd04b66",
			// Its own address. A custom domain: `npm run deploy:beta` attaches it,
			// and Cloudflare makes the DNS record and the certificate, since the
			// chapalaseminary.org zone is in this account. Kept here rather than
			// added in the dashboard, so a deploy can never quietly drop it. The
			// staff pages' Cloudflare Access rule covers this address, not the
			// workers.dev one. Production gets chapalaseminary.org only at the
			// cutover (docs/cutover.md, step 7), so it has no routes here.
			"routes": [
				{ "pattern": "beta.chapalaseminary.org", "custom_domain": true }
			],
			"observability": {
				"enabled": true
			},
			// bindings and vars are not inherited by an environment, so they are repeated
			"send_email": [{ "name": "EMAIL" }],
			"ai": { "binding": "AI" },
			"vars": {
				// beta is where the AI grader is live (docs/ai-grading.md section 1)
				"GRADING_MODE": "live",
				"GRADER_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
				"GRADER_MODEL_FALLBACK": "@cf/openai/gpt-oss-120b",
				"GRADER_PROMPT_VERSION": "2026-10-19.1",
				"MASTER_TESTS_ACTIVATION": "beta",
				"EMAIL_FROM": "Chapala Theological Seminary <certificates@chapalaseminary.org>",
				"EMAIL_REPLY_TO": "info@chapalaseminary.org",
				"NOTIFY_TO": "info@chapalaseminary.org",
				// beta's students are people testing the site: nobody is written
				// to; /staff/notes shows who would be, and the notes themselves
				"OUTREACH_MODE": "off",
				// no Monday summary from beta: it went to the same inbox as
				// the live one and was taken for it (Wayne, 5 Oct 2026)
				"DIGEST_MODE": "off",
				"OUTREACH_FROM": "Wayne Cook at Chapala Theological Seminary <certificates@chapalaseminary.org>",
				"SITE_ORIGIN": "https://beta.chapalaseminary.org",
				// the same Access application covers beta's /staff
				"ACCESS_TEAM": "chapalatheological",
				"ACCESS_AUD": "debf55802de573c5790f05b163c141178b068b01ee8c84ef0ed14c26224bb25c"
				// COORD_ACCESS_AUD: the beta half of the coordinator Access
				// application. Unset until that application exists. See above.
			},
			"triggers": {
				"crons": ["0 15 * * *", "*/15 * * * *"]
			},
			"assets": {
				"directory": "./dist",
				"binding": "ASSETS",
				"html_handling": "none",
				"not_found_handling": "none",
				"run_worker_first": true
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "chapala-students-beta",
					"database_id": "ae98d4cb-2d74-4bc4-a0a0-f01c22e95a7b"
				}
			]
		}
	}
}
