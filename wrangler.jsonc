{
	// The seminary, as a Worker with static assets.
	//
	// NOT Cloudflare Pages. Pages answers /CTSActsUnit3.html with a 308 to
	// /CTSActsUnit3 and offers no way to turn that off. Every one of the 801
	// pages here ends in .html, 8,878 links between them do too, and the Astro
	// config sets `build.format: 'file'` for the sole purpose of keeping those
	// URLs exactly as students and search engines already have them. See
	// worker/index.js.
	//
	// DEPLOYING
	//   npx wrangler deploy                 -> chapalaseminary.org
	//   npx wrangler deploy --env beta      -> beta.chapalaseminary.org
	//
	// WHICH CLOUDFLARE ACCOUNT
	//
	// account_id is pinned, and that is not housekeeping. This repository is
	// worked on from a machine that has access to two Cloudflare accounts, and
	// wrangler with no account_id picks one for you. The first `d1 create` went
	// to the wrong account. A database in the wrong account is a minute's
	// cleanup; `wrangler deploy` in the wrong account publishes the seminary
	// into somebody else's, which is a different kind of afternoon.
	//
	// 119b0919229edb3185b69f1c6bd04b66 is the Chapala account. The personal
	// login on this machine is a member of it, so one login reaches both
	// accounts and this pin is what picks the right one. `npm run deploy`
	// checks that the credentials in use actually reach the account named here
	// before it publishes anything.
	//
	// A WARNING ABOUT `wrangler d1 create`
	//
	// It edits this file. It appends a new binding to the TOP-LEVEL
	// d1_databases -- under its own name, not "DB", and regardless of which
	// environment the database is for -- and reformats everything while it is
	// there. So after creating a database: take the id it printed, put it in
	// the right place below, and delete the block it added.
	// tools/verify-worker-config.mjs fails until that is done.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chapala-seminary",
	"account_id": "119b0919229edb3185b69f1c6bd04b66",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-01",
	"observability": {
		"enabled": true
	},
	// Outgoing email (worker/email.js). The API key is a secret, never here:
	//   npx wrangler secret put RESEND_API_KEY            (production)
	//   npx wrangler secret put RESEND_API_KEY --env beta (beta)
	"vars": {
		"EMAIL_FROM": "Chapala Theological Seminary <certificates@chapalaseminary.org>",
		"EMAIL_REPLY_TO": "info@chapalaseminary.org",
		// where the seminary is told of completions and certificates (worker/notify.js)
		"NOTIFY_TO": "info@chapalaseminary.org"
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// "none": no rewriting of any kind. /CTSActsUnit3.html is served as
		// asked. It also means "/" is not resolved to "/index.html", so the
		// Worker does that itself -- visibly, and checked by
		// tools/verify-worker-routing.mjs.
		"html_handling": "none",
		"not_found_handling": "none",
		// Every request goes through the Worker, assets included. With the
		// default (false) the assets are served without the Worker ever running,
		// and the staging guard in worker/index.js would protect nothing: the
		// HTML pages, which are the entire indexing problem, would go straight
		// out with no header on them.
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "chapala-students",
			"database_id": "88a0b667-c2a6-4598-8779-0eb8970ae10d"
		}
	],
	"env": {
		// beta.chapalaseminary.org. Same code, same assets, its own database --
		// so that registering a test student while checking the site cannot
		// leave a row in the real students' table.
		"beta": {
			"name": "chapala-seminary-beta",
			"account_id": "119b0919229edb3185b69f1c6bd04b66",
			"observability": {
				"enabled": true
			},
			// vars are not inherited by an environment, so they are repeated
			"vars": {
				"EMAIL_FROM": "Chapala Theological Seminary <certificates@chapalaseminary.org>",
				"EMAIL_REPLY_TO": "info@chapalaseminary.org",
				"NOTIFY_TO": "info@chapalaseminary.org"
			},
			"assets": {
				"directory": "./dist",
				"binding": "ASSETS",
				"html_handling": "none",
				"not_found_handling": "none",
				"run_worker_first": true
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "chapala-students-beta",
					"database_id": "ae98d4cb-2d74-4bc4-a0a0-f01c22e95a7b"
				}
			]
		}
	}
}